# 云端账号与存档服务端环境变量模板（复制为 .env 后按需修改）
# 数据库：Neon serverless Postgres（neon.tech 免费层，建议 Region 选 Singapore 与 Vercel 同区）
# 配置后执行 bun run db:push 建 5 张表（Player / AuthToken / PairCode / QrLogin / CloudSave）
# 详见小程序 README「云端同步与统一账号 → 服务端部署」

# 运行时连接串：Neon 控制台 → Connection Details → Pooled（加 pgbouncer=true 走事务池，serverless 友好）
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15

# 建表/迁移连接串：Neon 同页的 Direct（UNPOOLED）那条，仅 prisma db push / migrate 使用
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# 小程序微信登录（可选）：配置后 POST /api/mp/login 生效；
# 不配置时小程序端自动降级本机身份（登录不阻塞，云同步用本机 gid 账号）
# WX_SECRET 取自 mp.weixin.qq.com → 开发管理 → 开发设置 → AppSecret（32 位十六进制）
# Vercel 部署：以下变量一并配到 Vercel 项目 Settings → Environment Variables；
# 小程序后台服务器 IP 白名单必须关闭（Vercel 出口 IP 不固定，开启必报 40164）
WX_APPID=wx4af46626b47c7cb1
WX_SECRET=

# openid 哈希盐（可选，默认 tx-adventure；更换会使已有微信账号身份重置）
# WX_UID_SALT=

# 扫码登录小程序码版本（可选）：release（默认，需小程序已发布 pages/web-login/index）/ trial / develop
# 未发布前本地/体验版调试设为 trial；部署后 curl -X POST https://你的域名/api/web/qr/create 验证（503=WX 凭据未配）
# WX_QR_ENV_VERSION=
