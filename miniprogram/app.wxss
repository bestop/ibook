/* 全局风格：蛋仔派对 × 多邻国融合（湖蓝奶油底纹保留，主色切换多邻国猫头鹰绿，
   3D 底边按压按钮 / 白底灰描边卡片 / 药丸进度条，令牌见 page 变量） */
page {
  /* —— Duolingo-style Design Tokens —— */
  --dl-owl-green: #58cc02;
  --dl-owl-green-deep: #58a700;
  --dl-owl-green-light: #89e219;
  --dl-owl-green-pale: #dbf8c5;
  --dl-streak-orange: #ff9600;
  --dl-gem-pink: #ce82ff;
  --dl-eel-blue: #1cb0f6;
  --dl-eel-blue-deep: #1899d6;
  --dl-cardinal-red: #ff4b4b;
  --dl-cardinal-red-deep: #d63131;
  --dl-bee-yellow: #ffc800;
  --dl-snow: #ffffff;
  --dl-eel: #f7f7f7;
  --dl-swan: #e5e5e5;
  --dl-ink: #3c3c3c;
  --dl-ink-soft: #777777;
  --dl-ink-mute: #afafaf;
  --dl-depth: 8rpx; /* 3D 底边厚度（4px） */

  background-color: #eaf8ff;
  background-image:
    /* 糖纸波点：白点+淡紫点双层点阵，蛋仔派对式奶油底纹 */
    radial-gradient(circle, rgba(255, 255, 255, 0.6) 3rpx, rgba(255, 255, 255, 0) 4rpx) 0 0 / 52rpx 52rpx,
    radial-gradient(circle, rgba(124, 77, 255, 0.05) 3rpx, rgba(124, 77, 255, 0) 4rpx) 26rpx 26rpx / 52rpx 52rpx,
    radial-gradient(circle at 12% 6%, rgba(255, 255, 255, 0.75) 0, rgba(255, 255, 255, 0) 14%),
    radial-gradient(circle at 88% 9%, rgba(255, 255, 255, 0.65) 0, rgba(255, 255, 255, 0) 13%),
    radial-gradient(circle at 78% 26%, rgba(255, 214, 102, 0.18) 0, rgba(255, 214, 102, 0) 10%),
    radial-gradient(circle at 6% 30%, rgba(255, 153, 204, 0.1) 0, rgba(255, 153, 204, 0) 12%),
    radial-gradient(circle at 30% 12%, rgba(62, 198, 255, 0.12) 0, rgba(62, 198, 255, 0) 10%),
    linear-gradient(180deg, #ddf3ff 0%, #eaf8ff 26%, #ffeff7 62%, #fff9f0 100%);
  background-attachment: fixed;
  font-size: 30rpx;
  color: #3d3a6e;
  font-family: 'Yuanti SC', 'YouYuan', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

button.btn-primary::after,
button.btn-ghost::after,
button.btn-sun::after {
  border: none;
}

/* ===== 玻璃果冻卡片 → 多邻国白卡：白底 + 灰描边 + 平底影 ===== */
.card {
  background: var(--dl-snow);
  border: 4rpx solid var(--dl-swan);
  border-radius: 40rpx;
  box-shadow:
    0 4rpx 0 var(--dl-swan),
    0 16rpx 34rpx rgba(93, 74, 156, 0.06);
  padding: 28rpx;
  box-sizing: border-box;
}

/* ===== 大号果冻按钮：多邻国猫头鹰绿主 CTA，3D 底边按压（压下底边消失） =====
   文字用 flex 确定性水平/垂直居中（不依赖微信 button 默认行高，
   避免 emoji+圆体粗字在部分机型上偏移）；text-indent 补偿 letter-spacing 尾随空隙 */
.btn-primary {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #7be12d 0%, #58cc02 55%, #4dbb00 100%);
  color: #fff;
  border: none;
  border-radius: 999rpx;
  font-weight: 900;
  text-align: center;
  padding: 36rpx 24rpx;
  line-height: 1.3;
  text-indent: 2rpx;
  font-size: 34rpx;
  letter-spacing: 2rpx;
  box-sizing: border-box;
  box-shadow:
    inset 0 6rpx 0 rgba(255, 255, 255, 0.3),
    0 8rpx 0 var(--dl-owl-green-deep),
    0 16rpx 30rpx rgba(88, 204, 2, 0.24);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease;
}
.btn-primary:active {
  transform: translateY(8rpx) scale(0.99);
  box-shadow:
    inset 0 5rpx 0 rgba(255, 255, 255, 0.22),
    0 2rpx 0 var(--dl-owl-green-deep),
    0 8rpx 16rpx rgba(88, 204, 2, 0.18);
}
.btn-primary.disabled {
  opacity: 0.45;
  box-shadow: none;
}

/* 活力黄副 CTA（签到等每日仪式按钮） */
.btn-sun {
  color: #7a4d00;
  background: linear-gradient(180deg, #ffe066 0%, #ffc93c 100%);
  box-shadow:
    inset 0 6rpx 0 rgba(255, 255, 255, 0.4),
    0 5rpx 0 #e8a400,
    0 16rpx 30rpx rgba(255, 201, 60, 0.3);
}
.btn-sun:active {
  transform: translateY(4rpx) scale(0.99);
  box-shadow:
    inset 0 5rpx 0 rgba(255, 255, 255, 0.3),
    0 2rpx 0 #e8a400,
    0 8rpx 16rpx rgba(255, 201, 60, 0.22);
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: var(--dl-eel-blue);
  border: 4rpx solid var(--dl-swan);
  border-radius: 999rpx;
  font-weight: 900;
  text-align: center;
  padding: 36rpx 24rpx;
  line-height: 1.3;
  box-sizing: border-box;
  font-size: 31rpx;
  letter-spacing: 2rpx; /* 与主按钮字距统一 */
  text-indent: 2rpx;
  box-shadow:
    0 4rpx 0 var(--dl-swan),
    0 12rpx 24rpx rgba(93, 74, 156, 0.06);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease;
}
.btn-ghost:active {
  transform: translateY(4rpx);
  box-shadow:
    0 2rpx 0 var(--dl-swan),
    0 6rpx 14rpx rgba(93, 74, 156, 0.05);
}
.btn-ghost.disabled {
  opacity: 0.45;
  box-shadow: none;
}

/* view 版按钮按压态（hover-class="btn-pressed"）：与 .btn-primary:active 同手感 */
.btn-pressed {
  transform: translateY(3rpx) scale(0.99);
  opacity: 0.92;
}

/* ===== 贴纸标签：白描边 + 硬底影 ===== */
.tag {
  display: inline-block;
  white-space: nowrap;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  background: #fff1bf;
  color: #a16207;
  border: 2rpx solid #fff;
  box-shadow: 0 4rpx 0 rgba(240, 164, 0, 0.16);
}

.badge-row {
  display: flex;
  gap: 14rpx;
}
.badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}
.badge.gold { background: #fff1bf; color: #a16207; }
.badge.orange { background: #ffe3ee; color: #e0407f; }
.badge.green { background: var(--dl-owl-green-pale); color: var(--dl-owl-green-deep); }

/* ===== 标题：蛋仔糖果标签（白描边胶囊 + 微倾斜） ===== */
.section-title {
  display: inline-block;
  font-size: 31rpx;
  font-weight: 900;
  color: #3d3a6e;
  margin: 34rpx 6rpx 18rpx;
  background: linear-gradient(180deg, #ffffff 0%, #eef9ff 100%);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  padding: 10rpx 30rpx;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.85),
    0 10rpx 24rpx rgba(93, 74, 156, 0.1);
  transform: rotate(-1deg); /* 全站唯一贴纸倾斜保留：章节标签品牌记忆点 */
}

.empty-tip {
  text-align: center;
  color: #8a87b8;
  font-weight: 800;
  padding: 60rpx 0;
}

/* ===== 通用蛋仔动效（弹动回弹） ===== */
@keyframes eggy-pop {
  0% { transform: scale(0.5); opacity: 0; }
  62% { transform: scale(1.12); opacity: 1; }
  82% { transform: scale(0.96); }
  100% { transform: scale(1); opacity: 1; }
}
/* 列表交错入场：轻浮起不弹跳（backwards 填充保证延迟期间不可见） */
@keyframes rise-in {
  0% { transform: translateY(18rpx) scale(0.98); opacity: 0; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}
@keyframes eggy-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14rpx); }
}
@keyframes eggy-wobble {
  0%, 100% { transform: rotate(-4deg); }
  50% { transform: rotate(4deg); }
}
@keyframes eggy-spin {
  to { transform: rotate(360deg); }
}
/* 镭射彩虹闪扫（奖励面板） */
@keyframes laser-sweep {
  0% { transform: translateX(0); opacity: 0; }
  15% { opacity: 1; }
  60% { transform: translateX(300%); opacity: 1; }
  100% { transform: translateX(300%); opacity: 0; }
}
/* 糖果条纹流动（进度条） */
@keyframes stripe-move {
  to { background-position: 34rpx 0, 0 0; }
}
/* 危险脉动（倒计时告急） */
@keyframes pulse-soft {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}
/* 连击跳动 */
@keyframes combo-pulse {
  0%, 100% { transform: scale(1) rotate(-2deg); }
  50% { transform: scale(1.1) rotate(2deg); }
}
/* 底部导航圆形底座弹跳 */
@keyframes tab-bounce {
  0%, 100% { transform: translateY(0) scale(1.18); }
  50% { transform: translateY(-6rpx) scale(1.24); }
}

/* ===== 图标体系：裸 emoji 直出 =====
   小程序全站图标已去除彩色芯片气泡（图标芯片样式体系于本轮整体移除），
   emoji 一律随文案裸直出，与我的页/地图/闯关页统一；网页端仍保留 IconChip 组件。
   注释内禁止出现星号+斜杠连续序列（wxss 注释完整性约定） */
/* 通用光泽材质：任意彩色胶囊加顶部高光 + 底部收影（不动布局与字色） */
.gloss-pill {
  box-shadow: inset 0 4rpx 0 rgba(255, 255, 255, 0.5), inset 0 -4rpx 0 rgba(0, 0, 0, 0.06);
}
