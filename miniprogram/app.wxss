/* 全局风格：蛋仔派对风 · 湖蓝×活力黄 潮玩盲盒卡通（大圆角/软塑胶/糖果浅色） */
page {
  background-color: #eaf8ff;
  background-image:
    /* 糖纸波点：白点+淡紫点双层点阵，蛋仔派对式奶油底纹 */
    radial-gradient(circle, rgba(255, 255, 255, 0.6) 3rpx, rgba(255, 255, 255, 0) 4rpx) 0 0 / 52rpx 52rpx,
    radial-gradient(circle, rgba(124, 77, 255, 0.05) 3rpx, rgba(124, 77, 255, 0) 4rpx) 26rpx 26rpx / 52rpx 52rpx,
    radial-gradient(circle at 12% 6%, rgba(255, 255, 255, 0.75) 0, rgba(255, 255, 255, 0) 14%),
    radial-gradient(circle at 88% 9%, rgba(255, 255, 255, 0.65) 0, rgba(255, 255, 255, 0) 13%),
    radial-gradient(circle at 78% 26%, rgba(255, 214, 102, 0.18) 0, rgba(255, 214, 102, 0) 10%),
    radial-gradient(circle at 6% 30%, rgba(255, 153, 204, 0.1) 0, rgba(255, 153, 204, 0) 12%),
    radial-gradient(circle at 30% 12%, rgba(62, 198, 255, 0.12) 0, rgba(62, 198, 255, 0) 10%),
    linear-gradient(180deg, #ddf3ff 0%, #eaf8ff 26%, #ffeff7 62%, #fff9f0 100%);
  background-attachment: fixed;
  font-size: 30rpx;
  color: #3d3a6e;
  font-family: 'Yuanti SC', 'YouYuan', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

button.btn-primary::after,
button.btn-ghost::after,
button.btn-sun::after {
  border: none;
}

/* ===== 半悬浮果冻卡片：大圆角 + 白描边厚度 + 柔和投影 ===== */
.card {
  background: linear-gradient(180deg, #ffffff 0%, #fdfcff 100%);
  border: 3rpx solid #fff;
  border-radius: 44rpx;
  box-shadow:
    0 0 0 3rpx rgba(148, 180, 255, 0.14),
    0 10rpx 0 rgba(148, 180, 255, 0.14),
    0 26rpx 46rpx rgba(93, 74, 156, 0.13);
  padding: 28rpx;
  box-sizing: border-box;
}

/* ===== 大号果冻按钮：亮湖蓝主 CTA，弹动回弹 =====
   文字用 flex 确定性水平/垂直居中（不依赖微信 button 默认行高，
   避免 emoji+圆体粗字在部分机型上偏移）；text-indent 补偿 letter-spacing 尾随空隙 */
.btn-primary {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #56cdff 0%, #2bb3f5 55%, #1fa9ec 100%);
  color: #fff;
  border: 4rpx solid #fff; /* 蛋仔式白描边 */
  border-radius: 999rpx;
  font-weight: 900;
  text-align: center;
  padding: 36rpx 24rpx;
  line-height: 1.3;
  text-indent: 2rpx;
  font-size: 34rpx;
  letter-spacing: 2rpx;
  box-sizing: border-box;
  box-shadow:
    0 0 0 3rpx rgba(18, 137, 201, 0.22),
    inset 0 8rpx 0 rgba(255, 255, 255, 0.35),
    0 8rpx 0 #1289c9,
    0 18rpx 30rpx rgba(31, 169, 236, 0.3);
  text-shadow: 0 2rpx 0 rgba(9, 106, 153, 0.3);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease;
}
.btn-primary:active {
  transform: translateY(7rpx) scale(0.99);
  box-shadow:
    0 0 0 3rpx rgba(18, 137, 201, 0.18),
    inset 0 6rpx 0 rgba(255, 255, 255, 0.25),
    0 2rpx 0 #1289c9,
    0 8rpx 16rpx rgba(31, 169, 236, 0.22);
}
.btn-primary.disabled {
  opacity: 0.45;
  box-shadow: none;
}

/* 活力黄副 CTA（签到等每日仪式按钮） */
.btn-sun {
  color: #7a4d00;
  background: linear-gradient(180deg, #ffe066 0%, #ffc93c 100%);
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.4);
  box-shadow:
    0 0 0 3rpx rgba(232, 164, 0, 0.25),
    inset 0 8rpx 0 rgba(255, 255, 255, 0.45),
    0 8rpx 0 #e8a400,
    0 18rpx 30rpx rgba(255, 201, 60, 0.35);
}
.btn-sun:active {
  transform: translateY(7rpx) scale(0.99);
  box-shadow:
    0 0 0 3rpx rgba(232, 164, 0, 0.2),
    inset 0 6rpx 0 rgba(255, 255, 255, 0.3),
    0 2rpx 0 #e8a400,
    0 8rpx 16rpx rgba(255, 201, 60, 0.25);
}

.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  color: #1b8fd1;
  border: 3rpx solid #bde7ff;
  border-radius: 999rpx;
  font-weight: 900;
  text-align: center;
  padding: 36rpx 24rpx;
  line-height: 1.3;
  box-sizing: border-box;
  font-size: 31rpx;
  box-shadow: 0 6rpx 0 #d8eeff;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease;
}
.btn-ghost:active {
  transform: translateY(5rpx);
  box-shadow: 0 2rpx 0 #d8eeff;
}
.btn-ghost.disabled {
  opacity: 0.45;
  box-shadow: none;
}

/* ===== 贴纸标签：白描边 + 硬底影 ===== */
.tag {
  display: inline-block;
  white-space: nowrap;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  background: #fff1bf;
  color: #a16207;
  border: 2rpx solid #fff;
  box-shadow: 0 4rpx 0 rgba(240, 164, 0, 0.16);
}

.badge-row {
  display: flex;
  gap: 14rpx;
}
.badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}
.badge.gold { background: #fff1bf; color: #a16207; }
.badge.orange { background: #ffe3ee; color: #e0407f; }
.badge.green { background: #d9fbee; color: #0e9f6e; }

/* ===== 标题：蛋仔糖果标签（白描边胶囊 + 微倾斜） ===== */
.section-title {
  display: inline-block;
  font-size: 31rpx;
  font-weight: 900;
  color: #3d3a6e;
  margin: 34rpx 6rpx 18rpx;
  background: linear-gradient(180deg, #ffffff 0%, #eef9ff 100%);
  border: 3rpx solid #fff;
  border-radius: 999rpx;
  padding: 10rpx 30rpx;
  box-shadow:
    inset 0 5rpx 0 rgba(255, 255, 255, 0.85),
    0 0 0 3rpx rgba(148, 180, 255, 0.16),
    0 6rpx 0 rgba(148, 180, 255, 0.2);
  transform: rotate(-1deg);
}

.empty-tip {
  text-align: center;
  color: #8a87b8;
  font-weight: 800;
  padding: 60rpx 0;
}

/* ===== 通用蛋仔动效（弹动回弹） ===== */
@keyframes eggy-pop {
  0% { transform: scale(0.5); opacity: 0; }
  62% { transform: scale(1.12); opacity: 1; }
  82% { transform: scale(0.96); }
  100% { transform: scale(1); opacity: 1; }
}
@keyframes eggy-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14rpx); }
}
@keyframes eggy-wobble {
  0%, 100% { transform: rotate(-4deg); }
  50% { transform: rotate(4deg); }
}
@keyframes eggy-spin {
  to { transform: rotate(360deg); }
}
/* 镭射彩虹闪扫（奖励面板） */
@keyframes laser-sweep {
  0% { transform: translateX(0); opacity: 0; }
  15% { opacity: 1; }
  60% { transform: translateX(300%); opacity: 1; }
  100% { transform: translateX(300%); opacity: 0; }
}
/* 糖果条纹流动（进度条） */
@keyframes stripe-move {
  to { background-position: 34rpx 0, 0 0; }
}
/* 危险脉动（倒计时告急） */
@keyframes pulse-soft {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}
/* 连击跳动 */
@keyframes combo-pulse {
  0%, 100% { transform: scale(1) rotate(-2deg); }
  50% { transform: scale(1.1) rotate(2deg); }
}
/* 底部导航圆形底座弹跳 */
@keyframes tab-bounce {
  0%, 100% { transform: translateY(0) scale(1.18); }
  50% { transform: translateY(-6rpx) scale(1.24); }
}
