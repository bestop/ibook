/* 全局风格：蛋仔派对风 · 糖果果冻卡通风 */
page {
  background-color: #cdefff;
  background-image:
    radial-gradient(circle at 10% 6%, rgba(255, 255, 255, 0.6) 0, rgba(255, 255, 255, 0) 16%),
    radial-gradient(circle at 90% 10%, rgba(255, 255, 255, 0.55) 0, rgba(255, 255, 255, 0) 14%),
    radial-gradient(circle at 82% 30%, rgba(255, 211, 53, 0.2) 0, rgba(255, 211, 53, 0) 12%),
    radial-gradient(circle at 8% 32%, rgba(255, 77, 141, 0.12) 0, rgba(255, 77, 141, 0) 14%),
    linear-gradient(180deg, #a8e6ff 0%, #cfefff 24%, #ffe9f5 62%, #fff7ea 100%);
  background-attachment: fixed;
  font-size: 30rpx;
  color: #3d3a6e;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

button.btn-primary::after,
button.btn-ghost::after {
  border: none;
}

/* ===== 果冻卡片 ===== */
.card {
  background: #fff;
  border: 3rpx solid #efe7ff;
  border-radius: 36rpx;
  box-shadow: 0 10rpx 0 rgba(139, 108, 255, 0.1), 0 18rpx 30rpx rgba(93, 74, 156, 0.08);
  padding: 28rpx;
  box-sizing: border-box;
}

/* ===== 果冻按钮 ===== */
.btn-primary {
  position: relative;
  background: linear-gradient(180deg, #ff8fb8 0%, #ff5e9c 55%, #ff4d8d 100%);
  color: #fff;
  border-radius: 999rpx;
  font-weight: 900;
  text-align: center;
  padding: 22rpx 0;
  font-size: 32rpx;
  box-shadow:
    inset 0 8rpx 0 rgba(255, 255, 255, 0.28),
    0 8rpx 0 #e0407f,
    0 16rpx 24rpx rgba(255, 77, 141, 0.26);
  text-shadow: 0 2rpx 0 rgba(183, 28, 92, 0.3);
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.btn-primary:active {
  transform: translateY(6rpx);
  box-shadow:
    inset 0 6rpx 0 rgba(255, 255, 255, 0.22),
    0 2rpx 0 #e0407f,
    0 8rpx 14rpx rgba(255, 77, 141, 0.2);
}
.btn-primary.disabled {
  opacity: 0.45;
  box-shadow: none;
}

.btn-ghost {
  background: #fff;
  color: #2e9be8;
  border: 3rpx solid #bde7ff;
  border-radius: 999rpx;
  font-weight: 900;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  box-shadow: 0 6rpx 0 #d8eeff;
  transition: transform 0.12s ease, box-shadow 0.12s ease;
}
.btn-ghost:active {
  transform: translateY(4rpx);
  box-shadow: 0 2rpx 0 #d8eeff;
}
.btn-ghost.disabled {
  opacity: 0.45;
  box-shadow: none;
}

/* ===== 糖果标签 ===== */
.tag {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  background: #fff1bf;
  color: #a16207;
}

.badge-row {
  display: flex;
  gap: 14rpx;
}
.badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  white-space: nowrap;
}
.badge.gold { background: #fff1bf; color: #a16207; }
.badge.orange { background: #ffe3ee; color: #e0407f; }
.badge.green { background: #d9fbee; color: #0e9f6e; }

.section-title {
  font-size: 33rpx;
  font-weight: 900;
  color: #3d3a6e;
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.8);
  margin: 34rpx 6rpx 18rpx;
}

.empty-tip {
  text-align: center;
  color: #8a87b8;
  font-weight: 800;
  padding: 60rpx 0;
}

/* ===== 通用蛋仔动效 ===== */
@keyframes eggy-pop {
  0% { transform: scale(0.5); opacity: 0; }
  62% { transform: scale(1.12); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
@keyframes eggy-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-14rpx); }
}
@keyframes eggy-wobble {
  0%, 100% { transform: rotate(-4deg); }
  50% { transform: rotate(4deg); }
}
@keyframes eggy-spin {
  to { transform: rotate(360deg); }
}
