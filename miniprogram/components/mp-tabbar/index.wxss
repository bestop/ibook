.tab-label {
  font-size: 20rpx;
  font-weight: 600;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}
/* 激活：金色图标 + 金色加粗文字（无底色胶囊，与参考图一致） */
.tab-active {
  color: #e89b2d;
}
.tab-active .tab-ico {
  background-color: #e89b2d;
  transform: translateY(-2rpx) scale(1.08);
}
.tab-active .tab-label {
  font-weight: 800;
  color: #e89b2d;
}
/* 错题数徽标：图标右上角小红点 */
.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -14rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff5c7a;
  border: 3rpx solid #fff;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
  box-shadow: 0 4rpx 8rpx rgba(240, 62, 107, 0.25);
}
