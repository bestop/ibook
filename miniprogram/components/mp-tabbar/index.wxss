.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  background: #fff;
  border-top: 3rpx solid #f2edff;
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -10rpx 30rpx rgba(93, 74, 156, 0.1);
  padding-bottom: env(safe-area-inset-bottom);
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 10rpx;
  margin: 0 6rpx;
  border-radius: 30rpx 30rpx 0 0;
  color: #a5a1cc;
  transition: background 0.2s ease;
}
.tab-emoji {
  font-size: 40rpx;
  line-height: 1.2;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.tab-label {
  font-size: 22rpx;
  font-weight: 700;
}
.tab-active {
  color: #1fa9ec;
  background: #e3f4ff;
}
.tab-active .tab-emoji {
  transform: translateY(-4rpx) scale(1.18);
}
.tab-active .tab-label {
  font-weight: 900;
}
