.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  background: #fff;
  border-top: 3rpx solid #efe7ff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -10rpx 30rpx rgba(93, 74, 156, 0.1);
  padding-bottom: env(safe-area-inset-bottom);
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 10rpx;
  color: #a5a1cc;
}
.tab-emoji {
  font-size: 40rpx;
  line-height: 1.2;
  transition: transform 0.2s ease;
}
.tab-label {
  font-size: 22rpx;
  font-weight: 700;
}
.tab-active {
  color: #ff4d8d;
}
.tab-active .tab-emoji {
  transform: translateY(-4rpx) scale(1.18);
}
.tab-active .tab-label {
  font-weight: 900;
}
