/* 轻盈悬浮 Dock：磨砂玻璃 + 轻投影，极简优雅 */
.tabbar {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(18rpx + env(safe-area-inset-bottom));
  z-index: 50;
  display: flex;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 36rpx;
  box-shadow: 0 10rpx 32rpx rgba(93, 74, 156, 0.14);
  padding: 12rpx 10rpx;
  box-sizing: border-box;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6rpx 0 4rpx;
  border-radius: 30rpx;
  color: #a5a1cc;
  transition: color 0.2s ease;
}
.tab-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
}
.tab-emoji {
  font-size: 42rpx;
  line-height: 1;
  opacity: 0.68;
  filter: saturate(0.8);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease, filter 0.2s ease;
}
.tab-label {
  font-size: 20rpx;
  font-weight: 600;
  margin-top: 6rpx;
  letter-spacing: 1rpx;
  white-space: nowrap;
}
/* 激活：轻底色胶囊 + 图标轻浮起（去黄底弹跳） */
.tab-active {
  color: #2aa9e8;
  background: linear-gradient(180deg, #f0faff 0%, #e4f5ff 100%);
}
.tab-active .tab-emoji {
  opacity: 1;
  filter: saturate(1.05);
  transform: translateY(-4rpx) scale(1.12);
}
.tab-active .tab-label {
  font-weight: 800;
}
/* 错题数徽标：图标右上角小红点 */
.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -18rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ff5c7a;
  border: 3rpx solid #fff;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
  box-shadow: 0 4rpx 8rpx rgba(240, 62, 107, 0.25);
}
