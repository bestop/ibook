/* 蛋仔派对式悬浮 Dock：悬浮胶囊 + 白描边 + 圆形底座弹跳 */
.tabbar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 50;
  display: flex;
  background: linear-gradient(180deg, #ffffff 0%, #f2faff 100%);
  border: 4rpx solid #fff;
  border-radius: 999rpx;
  box-shadow:
    0 0 0 3rpx rgba(148, 180, 255, 0.18),
    0 10rpx 0 rgba(148, 180, 255, 0.2),
    0 24rpx 40rpx rgba(93, 74, 156, 0.18);
  padding: 10rpx 14rpx;
  box-sizing: border-box;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0 6rpx;
  border-radius: 999rpx;
  color: #a5a1cc;
  transition: background 0.2s ease;
}
.tab-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  font-size: 38rpx;
  line-height: 1;
  border-radius: 50%;
  border: 3rpx solid transparent;
  transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.2s ease, border-color 0.2s ease;
}
.tab-label {
  font-size: 21rpx;
  font-weight: 700;
  margin-top: 4rpx;
  white-space: nowrap;
}
.tab-active {
  color: #1b8fd1;
  background: #e3f4ff;
}
/* 活跃 tab：活力黄圆形底座 + 弹跳 */
.tab-active .tab-emoji {
  background: linear-gradient(180deg, #ffe066 0%, #ffc93c 100%);
  border-color: #fff;
  box-shadow: 0 5rpx 0 rgba(232, 164, 0, 0.35), 0 10rpx 16rpx rgba(255, 201, 60, 0.35);
  animation: tab-bounce 1.6s ease-in-out infinite;
}
.tab-active .tab-label {
  font-weight: 900;
}
