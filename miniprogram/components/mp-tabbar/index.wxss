/* 简约扁平底部导航（参考图风格）：通栏白底导航条（贴底、顶部细线）。
   图标为单色扁平剪影：wxss 内嵌 base64 SVG 形状 + CSS mask 着色，
   未选中中性灰、激活金色，图标与文字同色，错题徽标保留 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 2rpx solid #e6edf3;
  box-shadow: 0 -8rpx 24rpx rgba(43, 90, 138, 0.07);
  padding: 12rpx 8rpx calc(12rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0 0;
  color: #a2a2a8;
  transition: color 0.2s ease;
}
.tab-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
}
/* 扁平剪影图标：SVG 形状做 mask，背景色即图标色 */
.tab-ico {
  width: 44rpx;
  height: 44rpx;
  background-color: #a2a2a8;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
