.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  background: rgba(255, 255, 255, 0.96);
  border-top: 3rpx solid #fde68a;
  padding-bottom: env(safe-area-inset-bottom);
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 0 10rpx;
  color: #9ca3af;
}
.tab-emoji {
  font-size: 40rpx;
  line-height: 1.2;
}
.tab-label {
  font-size: 22rpx;
  font-weight: 700;
}
.tab-active {
  color: #ea580c;
}
