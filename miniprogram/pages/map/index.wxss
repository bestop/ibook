.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}
/* 云朵装饰（不挡点击） */
.page::before {
  content: '☁️';
  position: absolute;
  top: 0;
  right: 26rpx;
  font-size: 48rpx;
  opacity: 0.5;
  pointer-events: none;
  animation: eggy-float 5s ease-in-out infinite;
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.head-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.head-texts {
  min-width: 0;
}
.head-emoji {
  font-size: 60rpx;
  animation: eggy-wobble 3.6s ease-in-out infinite;
}
.head-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #3d3a6e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.head-sub {
  font-size: 24rpx;
  color: #8a87b8;
  margin-top: 4rpx;
}

.error-box {
  text-align: center;
}
.error-text {
  color: #f03e6b;
  font-weight: 800;
  margin-bottom: 20rpx;
}
.retry-btn {
  margin: 0 60rpx;
}

/* ===== 每日挑战：活力黄盲盒卡 + 波点糖纸 ===== */
.daily-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 0 8rpx;
  overflow: hidden;
  background-image:
    radial-gradient(circle, rgba(255, 255, 255, 0.55) 3rpx, rgba(255, 255, 255, 0) 4rpx) 0 0 / 44rpx 44rpx,
    radial-gradient(circle, rgba(255, 199, 60, 0.12) 3rpx, rgba(255, 199, 60, 0) 4rpx) 22rpx 22rpx / 44rpx 44rpx,
    linear-gradient(135deg, #fffbea, #fff1bf);
  border-color: #ffe066;
  box-shadow:
    0 0 0 3rpx rgba(232, 164, 0, 0.12),
    0 10rpx 0 rgba(232, 164, 0, 0.12),
    0 24rpx 44rpx rgba(93, 74, 156, 0.1);
}
.daily-left {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.daily-emoji {
  font-size: 56rpx;
  animation: eggy-spin 7s linear infinite;
  flex-shrink: 0;
}
.daily-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #9a6b00;
}
.daily-sub {
  font-size: 22rpx;
  color: #8a87b8;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.daily-btn {
  padding: 32rpx 48rpx;
  font-size: 28rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ===== 关卡地图：奇偶交错缩进，蜿蜒路径感 ===== */
.level-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.level-card:active {
  transform: scale(0.96);
}
.level-locked {
  opacity: 0.55;
}
/* 已通关：薄荷绿描边浅底，一眼识别战果 */
.level-cleared {
  background: linear-gradient(180deg, #f4fff9 0%, #ffffff 100%);
  border-color: #a8f0d4;
  box-shadow:
    0 0 0 3rpx rgba(14, 159, 110, 0.1),
    0 10rpx 0 rgba(14, 159, 110, 0.1),
    0 26rpx 46rpx rgba(14, 159, 110, 0.08);
}
.level-alt {
  margin-left: 44rpx; /* 奇偶交错：地图小径感 */
  margin-right: 0;
}
.level-index {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #e6f6ff 0%, #cfeaff 100%);
  border: 3rpx solid #fff;
  color: #1b8fd1;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.85),
    0 5rpx 0 rgba(27, 143, 209, 0.18);
}
.level-cleared .level-index {
  background: linear-gradient(180deg, #d9fbee 0%, #b5f2da 100%);
  color: #0e9f6e;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.85),
    0 5rpx 0 rgba(14, 159, 110, 0.2);
}
.level-main {
  flex: 1;
  min-width: 0;
}
.level-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.level-title {
  font-size: 22rpx;
  color: #8a87b8;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.level-stars {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.star {
  color: #d9d6f2;
  font-size: 26rpx;
}
.star-on {
  color: #ffc53d;
  text-shadow: 0 2rpx 0 rgba(240, 164, 0, 0.35);
}
.level-done {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #0e9f6e;
  font-weight: 900;
}
.level-lock {
  font-size: 32rpx;
  color: #ff7ba9;
  font-weight: 900;
}
.tabbar-space {
  height: 60rpx;
}
