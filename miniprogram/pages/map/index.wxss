.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.head-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.head-emoji {
  font-size: 60rpx;
}
.head-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #c2410c;
}
.head-sub {
  font-size: 24rpx;
  color: #78716c;
  margin-top: 4rpx;
}

.error-box {
  text-align: center;
}
.error-text {
  color: #b45309;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.retry-btn {
  margin: 0 60rpx;
}

.daily-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 0 8rpx;
  background: linear-gradient(135deg, #fffbeb, #fef3c7);
}
.daily-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.daily-emoji {
  font-size: 56rpx;
}
.daily-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #92400e;
}
.daily-sub {
  font-size: 22rpx;
  color: #b45309;
  margin-top: 4rpx;
}
.daily-btn {
  padding: 14rpx 36rpx;
  font-size: 26rpx;
}

.level-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
}
.level-locked {
  opacity: 0.62;
}
.level-index {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #ffedd5;
  color: #c2410c;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}
.level-main {
  flex: 1;
  min-width: 0;
}
.level-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #431407;
}
.level-title {
  font-size: 22rpx;
  color: #78716c;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.level-stars {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.star {
  color: #e7e5e4;
  font-size: 26rpx;
}
.star-on {
  color: #f59e0b;
}
.level-done {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #047857;
  font-weight: 800;
}
.level-lock {
  font-size: 32rpx;
  color: #ea580c;
  font-weight: 900;
}
.tabbar-space {
  height: 60rpx;
}
