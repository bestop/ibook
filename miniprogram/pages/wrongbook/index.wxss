.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}
/* 云朵装饰（不挡点击） */
.page::before {
  content: '☁️';
  position: absolute;
  top: 2rpx;
  right: 28rpx;
  font-size: 48rpx;
  opacity: 0.5;
  pointer-events: none;
  animation: eggy-float 5s ease-in-out infinite;
}
/* ===== 错题本 head：草莓粉盲盒卡 ===== */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  background-image:
    radial-gradient(circle, rgba(255, 255, 255, 0.55) 3rpx, rgba(255, 255, 255, 0) 4rpx) 0 0 / 44rpx 44rpx,
    linear-gradient(135deg, #fff5f8, #ffe3ee);
  border-color: #ffd9e8;
  box-shadow:
    0 0 0 2rpx rgba(224, 64, 127, 0.1),
    0 14rpx 30rpx rgba(93, 74, 156, 0.1);
}
.head-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.head-sub {
  font-size: 22rpx;
  color: #8a87b8;
  margin-top: 6rpx;
}
.review-btn {
  width: 100%;
  margin: 10rpx -10rpx 28rpx; /* 负外边距向两侧出血：比上下卡片各宽一档，主 CTA 更醒目 */
  padding: 32rpx 44rpx;       /* 文字四周留边距：纵向加高 + 横向加宽 */
}
/* 按钮仅主文案（副标签胶囊已撤），居中交由 button 默认文本对齐 */
.review-main {
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
  text-indent: 6rpx; /* 补偿 letter-spacing 尾随空隙 */
  white-space: nowrap;
}
/* 空态裸 emoji（去气泡芯片后直出，继承 .empty-tip 居中） */
.empty-emoji {
  font-size: 84rpx;
  line-height: 1.2;
  margin-bottom: 8rpx;
}
/* 列表容器：交错入场的 nth-child 局部计数锚点 */
.wrong-list {
  min-width: 0;
}
.wrong-card {
  margin-bottom: 16rpx;
  animation: rise-in 0.3s ease-out backwards;
}
/* 交错延迟：消灭清单逐张浮现（5 张后统一档） */
.wrong-card:nth-child(1) { animation-delay: 0.02s; }
.wrong-card:nth-child(2) { animation-delay: 0.07s; }
.wrong-card:nth-child(3) { animation-delay: 0.12s; }
.wrong-card:nth-child(4) { animation-delay: 0.17s; }
.wrong-card:nth-child(n + 5) { animation-delay: 0.22s; }
.wrong-q {
  font-size: 28rpx;
  font-weight: 700;
  color: #3d3a6e;
  line-height: 1.6;
}
.wrong-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}
/* meta 左组：科目 + 间隔状态（右侧错次徽章保持单独右对齐） */
.wrong-meta-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
/* 间隔状态徽标（SRS 间隔调度，与复习组卷同规则）：到期=暖粉提示立即练，未到期=雾紫预告 */
.srs-tag {
  font-size: 20rpx;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  white-space: nowrap;
}
.srs-due {
  color: #f03e6b;
  background: #ffe9ef;
  border: 2rpx solid #fff;
  box-shadow: 0 4rpx 0 rgba(240, 62, 107, 0.12);
}
.srs-later {
  color: #6f6cae;
  background: #eeeefb;
  border: 2rpx solid #fff;
  box-shadow: 0 4rpx 0 rgba(111, 108, 174, 0.12);
}
/* 错次徽章：白描边粉胶囊 */
.wrong-count {
  font-size: 22rpx;
  color: #f03e6b;
  font-weight: 900;
  background: #ffe9ef;
  border: 2rpx solid #fff;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  box-shadow: 0 4rpx 0 rgba(240, 62, 107, 0.12);
  white-space: nowrap;
}
/* ===== 薄弱考点 Top3（借鉴聪聪学堂掌握度闭环，与网页版同构） ===== */
.weak-tags {
  margin: 0 0 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #fff5f8;
  border: 2rpx solid #ffc9da;
}
.weak-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #f03e6b;
}
.weak-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.weak-chip {
  font-size: 22rpx;
  font-weight: 800;
  color: #f03e6b;
  background: #fff;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  box-shadow: 0 4rpx 10rpx rgba(240, 62, 107, 0.12);
}
.weak-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #f79ab3;
  font-weight: 700;
}
/* ===== 错题卡内的答案与解析（与网页版错题本同构） ===== */
.wrong-answer {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 16rpx;
  background: #f0fff9;
  font-size: 24rpx;
  font-weight: 800;
  color: #0e9f6e;
  line-height: 1.5;
}
.wrong-explain {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a87b8;
  line-height: 1.6;
}
.tabbar-space {
  height: 180rpx; /* 底部通栏导航条：图标+文字行高 + safe-area */
}
