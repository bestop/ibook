.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}
/* 云朵装饰（不挡点击） */
.page::before {
  content: '☁️';
  position: absolute;
  top: 2rpx;
  right: 28rpx;
  font-size: 48rpx;
  opacity: 0.5;
  pointer-events: none;
  animation: eggy-float 5s ease-in-out infinite;
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.head-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.head-sub {
  font-size: 22rpx;
  color: #8a87b8;
  margin-top: 6rpx;
}
.review-btn {
  margin-bottom: 8rpx;
}
.wrong-card {
  margin-bottom: 16rpx;
}
.wrong-q {
  font-size: 26rpx;
  font-weight: 700;
  color: #3d3a6e;
  line-height: 1.6;
}
.wrong-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
.wrong-count {
  font-size: 22rpx;
  color: #f03e6b;
  font-weight: 900;
}
.tabbar-space {
  height: 140rpx;
}
