.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}
/* 云朵装饰（不挡点击） */
.page::before {
  content: '☁️';
  position: absolute;
  top: 2rpx;
  right: 28rpx;
  font-size: 48rpx;
  opacity: 0.5;
  pointer-events: none;
  animation: eggy-float 5s ease-in-out infinite;
}
/* ===== 错题本 head：草莓粉盲盒卡 ===== */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  background-image:
    radial-gradient(circle, rgba(255, 255, 255, 0.55) 3rpx, rgba(255, 255, 255, 0) 4rpx) 0 0 / 44rpx 44rpx,
    linear-gradient(135deg, #fff5f8, #ffe3ee);
  border-color: #ffd9e8;
  box-shadow:
    0 0 0 3rpx rgba(224, 64, 127, 0.08),
    0 10rpx 0 rgba(224, 64, 127, 0.08),
    0 26rpx 46rpx rgba(93, 74, 156, 0.1);
}
.head-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.head-sub {
  font-size: 22rpx;
  color: #8a87b8;
  margin-top: 6rpx;
}
.review-btn {
  margin-bottom: 8rpx;
}
/* 按钮内容：主文案 + 轻胶囊副标签，替代原「📖 开始复习（随机 10 题）」 */
.review-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}
.review-main {
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  text-indent: 4rpx; /* 补偿 letter-spacing 尾随空隙 */
}
.review-chip {
  margin-left: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #eafaff;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  line-height: 1.4;
}
.wrong-card {
  margin-bottom: 16rpx;
}
.wrong-q {
  font-size: 26rpx;
  font-weight: 700;
  color: #3d3a6e;
  line-height: 1.6;
}
.wrong-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
}
/* 错次徽章：白描边粉胶囊 */
.wrong-count {
  font-size: 22rpx;
  color: #f03e6b;
  font-weight: 900;
  background: #ffe9ef;
  border: 2rpx solid #fff;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
  box-shadow: 0 4rpx 0 rgba(240, 62, 107, 0.12);
  white-space: nowrap;
}
.tabbar-space {
  height: 200rpx; /* 悬浮 Dock：胶囊高+bottom 16rpx+safe-area */
}
