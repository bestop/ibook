/* 宠物页：领养流 + 宠物主页 + 剧情阅读器 */
.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 160rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #ddf3ff 0%, #eef9ff 40%, #fdf6ec 100%);
}
.press { opacity: 0.85; transform: scale(0.98); }
.tabbar-space {
  height: 180rpx; /* 底部通栏导航条：图标+文字行高 + safe-area */
}

/* ---------- 领养流 ---------- */
.adopt-head { text-align: center; padding: 30rpx 0 10rpx; }
.adopt-egg { font-size: 88rpx; animation: float 2.4s ease-in-out infinite; }
.adopt-title { margin-top: 14rpx; font-size: 42rpx; font-weight: 900; color: #f97316; }
.adopt-sub { margin-top: 8rpx; font-size: 26rpx; font-weight: 700; color: #9ca3af; }
.adopt-cards { margin-top: 26rpx; display: flex; gap: 22rpx; }
.adopt-card {
  flex: 1;
  background: #fff;
  border: 3rpx solid #e5e7eb;
  border-radius: 40rpx;
  padding: 34rpx 20rpx 26rpx;
  text-align: center;
  box-shadow: 0 8rpx 0 rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}
.adopt-card-active {
  border-color: #fb923c;
  background: #fff7ed;
  box-shadow: 0 10rpx 0 rgba(251, 146, 60, 0.35);
  transform: translateY(-4rpx);
}
.adopt-img { width: 170rpx; height: 170rpx; }
.adopt-card-active .adopt-img { animation: wiggle 0.6s ease; }
@keyframes wiggle {
  0%, 100% { transform: rotate(0); }
  25% { transform: rotate(-7deg) scale(1.06); }
  60% { transform: rotate(6deg) scale(1.04); }
}
.adopt-name { margin-top: 14rpx; font-size: 34rpx; font-weight: 900; color: #1f2937; }
.adopt-desc { margin-top: 6rpx; font-size: 23rpx; font-weight: 700; color: #9ca3af; }
.adopt-traits { margin-top: 14rpx; display: flex; flex-wrap: wrap; justify-content: center; gap: 8rpx; }
.trait { font-size: 19rpx; font-weight: 800; color: #9ca3af; background: #f3f4f6; border-radius: 999rpx; padding: 5rpx 14rpx; }
.trait-active { color: #ea580c; background: #ffedd5; }
.adopt-picked { margin-top: 12rpx; font-size: 23rpx; font-weight: 800; color: #f97316; }
.adopt-naming {
  margin-top: 26rpx;
  background: #fff;
  border: 3rpx solid #fde68a;
  border-radius: 40rpx;
  padding: 30rpx;
}
.naming-title { font-size: 27rpx; font-weight: 800; color: #374151; }
.naming-row { margin-top: 16rpx; display: flex; align-items: center; gap: 14rpx; }
.naming-img { width: 76rpx; height: 76rpx; flex-shrink: 0; }
.naming-input {
  flex: 1;
  border: 3rpx solid #e5e7eb;
  border-radius: 26rpx;
  padding: 18rpx 26rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #374151;
}
.naming-chips { margin-top: 16rpx; display: flex; flex-wrap: wrap; gap: 12rpx; }
.chip { font-size: 23rpx; font-weight: 800; color: #d97706; background: #fffbeb; border-radius: 999rpx; padding: 10rpx 24rpx; }
.chip-active { color: #fff; background: #f97316; }
.adopt-btn {
  margin-top: 24rpx;
  background: #f97316;
  color: #fff;
  font-size: 30rpx;
  font-weight: 900;
  border-radius: 30rpx;
  padding: 8rpx 0;
  box-shadow: 0 6rpx 0 rgba(234, 88, 12, 0.5);
}

/* ---------- 宠物主页 ---------- */
.hero {
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #bae6fd 0%, #e0f2fe 45%, #dcfce7 100%);
  border: 3rpx solid #bae6fd;
  border-radius: 44rpx;
  padding: 30rpx 24rpx 28rpx;
  text-align: center;
  box-shadow: 0 10rpx 0 rgba(0, 0, 0, 0.05);
}
.hero-cloud { position: absolute; font-size: 40rpx; opacity: 0.7; animation: drift 14s linear infinite; }
.hero-cloud.c1 { left: 30rpx; top: 24rpx; }
.hero-cloud.c2 { right: 44rpx; top: 52rpx; animation-duration: 18s; }
.hero-grass { position: absolute; font-size: 34rpx; opacity: 0.75; }
.hero-grass.g1 { left: 56rpx; bottom: 22rpx; }
.hero-grass.g2 { right: 70rpx; bottom: 30rpx; }
@keyframes drift {
  0% { transform: translateX(0); }
  50% { transform: translateX(26rpx); }
  100% { transform: translateX(0); }
}

/* 心情/昼夜场景变体：开心不变（光环在宠物旁），低落转黄昏暖调，夜晚转深蓝星空 */
.hero-low { background: linear-gradient(180deg, #fecdd3 0%, #fed7aa 45%, #fef3c7 100%); border-color: #fda4af; }
.hero-night { background: linear-gradient(180deg, #1e3a8a 0%, #312e81 50%, #1e40af 100%); border-color: #3b82f6; }
.hero-night .pet-name { color: #f0f9ff; }
.hero-night .pet-tag { color: #7dd3fc; }
.hero-night .pet-stage-desc { color: #93c5fd; }
.hero-night .exp-row { color: #bae6fd; }
.hero-night .exp-hint { color: #94a3b8; }
.hero-night .exp-bar { background: #1e3a8a; border-color: #3b82f6; }
.hero-night .hero-grass { opacity: 0.45; }
.hero-star { position: absolute; opacity: 0.85; animation: twinkle 1.8s ease-in-out infinite; }
.hero-star.s1 { left: 44rpx; top: 30rpx; }
.hero-star.s2 { right: 84rpx; top: 58rpx; animation-delay: 0.5s; }
.hero-star.s3 { left: 156rpx; top: 84rpx; animation-delay: 1s; font-size: 26rpx; }
.hero-moon { position: absolute; right: 44rpx; top: 26rpx; font-size: 44rpx; opacity: 0.95; }
@keyframes twinkle {
  0%, 100% { opacity: 0.35; transform: scale(0.85); }
  50% { opacity: 1; transform: scale(1.1); }
}
.pet-days {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #b45309;
  background: #fef3c7;
  border: 2rpx solid #fde68a;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}
.hero-night .pet-days { color: #fcd34d; background: rgba(30, 58, 138, 0.55); border-color: #3b82f6; }

/* 心情开心光环：宠物身旁两颗循环漂浮的心心/星星 */
.halo { position: absolute; font-size: 34rpx; z-index: 1; pointer-events: none; animation: haloFloat 2.6s ease-in-out infinite; }
.halo.h1 { left: -6rpx; top: 36rpx; }
.halo.h2 { right: -12rpx; top: 116rpx; animation-delay: 1.3s; }
@keyframes haloFloat {
  0%, 100% { transform: translateY(0) scale(1); opacity: 0.85; }
  50% { transform: translateY(-18rpx) scale(1.15); opacity: 1; }
}

/* 点击粒子：上浮淡出（left 由内联样式 calc(50% + x px) 控制） */
.particle {
  position: absolute;
  top: 6rpx;
  font-size: 40rpx;
  z-index: 2;
  pointer-events: none;
  animation: riseFade 1.1s ease-out forwards;
}
@keyframes riseFade {
  0% { opacity: 1; transform: translateY(0) scale(0.6); }
  100% { opacity: 0; transform: translateY(-110px) scale(1.25); }
}

/* 连击彩蛋转圈 */
.pet-spin { animation: spinOnce 0.9s ease-in-out !important; }
@keyframes spinOnce {
  0% { transform: rotate(0) scale(1); }
  45% { transform: rotate(360deg) scale(1.12); }
  100% { transform: rotate(720deg) scale(1); }
}

/* 进化光效：光柱升起 + 星光闪耀 + 徽标弹出，宠物缓慢旋转一周半 */
.hero-evolving .pet-img { animation: spinSlow 2.4s ease-in-out; }
@keyframes spinSlow {
  0% { transform: rotate(0) scale(1); }
  50% { transform: rotate(360deg) scale(1.18); }
  100% { transform: rotate(720deg) scale(1); }
}
.evolve-fx { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
.evolve-beam {
  position: absolute;
  left: 50%;
  bottom: 100rpx;
  width: 12rpx;
  height: 0;
  transform: translateX(-50%);
  background: linear-gradient(180deg, rgba(253, 224, 71, 0), #fde047, rgba(253, 224, 71, 0));
  border-radius: 999rpx;
  animation: beamUp 1.4s ease-out forwards;
}
@keyframes beamUp {
  0% { height: 0; opacity: 0; }
  30% { height: 330rpx; opacity: 1; }
  100% { height: 400rpx; opacity: 0; }
}
.evolve-sparks {
  position: absolute;
  top: 36%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 44rpx;
  letter-spacing: 18rpx;
  animation: sparklePulse 1s ease-in-out infinite;
}
@keyframes sparklePulse {
  0%, 100% { opacity: 0.5; transform: translate(-50%, -50%) scale(0.9); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.15); }
}
.evolve-txt {
  position: absolute;
  top: 34rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(90deg, #fbbf24, #f97316);
  color: #fff;
  font-size: 26rpx;
  font-weight: 900;
  border-radius: 999rpx;
  padding: 10rpx 32rpx;
  box-shadow: 0 6rpx 16rpx rgba(251, 191, 36, 0.5);
  animation: popIn 0.4s ease;
}
@keyframes popIn {
  0% { transform: translateX(-50%) scale(0.5); opacity: 0; }
  70% { transform: translateX(-50%) scale(1.1); opacity: 1; }
  100% { transform: translateX(-50%) scale(1); opacity: 1; }
}
.mood-bubble {
  display: inline-block;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 10rpx 26rpx;
  font-size: 23rpx;
  font-weight: 800;
  color: #4b5563;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}
.pet-stage { position: relative; display: inline-block; padding: 4rpx 60rpx 0; }
/* 全身静帧形象：悬浮 + 呼吸缩放（源 GIF 不入包，动效由 CSS 承担） */
.pet-img {
  width: 320rpx;
  height: 320rpx;
  animation: floatBreath 3.2s ease-in-out infinite;
}
@keyframes floatBreath {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-12rpx) scale(1.04); }
}
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
.pet-bounce { animation: bounceOnce 0.5s ease !important; }
@keyframes bounceOnce {
  0% { transform: scale(1); }
  35% { transform: scale(1.12) rotate(-5deg); }
  70% { transform: scale(0.96) rotate(4deg); }
  100% { transform: scale(1); }
}
.tap-bubble {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: 8rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #f472b6;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.1);
  white-space: nowrap;
  z-index: 2;
}
.pet-name { margin-top: 8rpx; font-size: 34rpx; font-weight: 900; color: #1f2937; }
.pet-tag { margin-left: 14rpx; font-size: 21rpx; font-weight: 800; color: #0ea5e9; }
.pet-stage-desc { margin-top: 4rpx; font-size: 21rpx; font-weight: 700; color: #9ca3af; }
.exp-box { margin: 22rpx auto 0; max-width: 560rpx; }
.exp-row { display: flex; justify-content: space-between; font-size: 22rpx; font-weight: 800; color: #0284c7; }
.exp-hint { color: #9ca3af; font-weight: 700; }
.exp-bar { margin-top: 8rpx; height: 22rpx; background: #e0f2fe; border: 2rpx solid #bae6fd; border-radius: 999rpx; overflow: hidden; }
.exp-bar-fill { height: 100%; background: linear-gradient(90deg, var(--dl-owl-green-light), var(--dl-owl-green)); border-radius: 999rpx; transition: width 0.5s ease; }

/* 心情 + 喂食 */
.care-row { margin-top: 22rpx; display: flex; gap: 20rpx; }
.care-card {
  flex: 1;
  background: #fff;
  border-radius: 36rpx;
  padding: 26rpx;
  box-sizing: border-box;
}
.mood-card { border: 3rpx solid #fecdd3; }
.feed-card { border: 3rpx solid #fde68a; display: flex; flex-direction: column; }
.care-title { font-size: 22rpx; font-weight: 800; }
.mood-card .care-title { color: #f43f5e; }
.feed-card .care-title { color: #d97706; }
.mood-num { margin-top: 8rpx; font-size: 46rpx; font-weight: 900; color: #1f2937; }
.mood-max { font-size: 24rpx; color: #9ca3af; font-weight: 700; }
.mood-bar { margin-top: 10rpx; height: 18rpx; background: #ffe4e6; border-radius: 999rpx; overflow: hidden; }
.mood-bar-fill { height: 100%; background: linear-gradient(90deg, #fb7185, #fb923c); border-radius: 999rpx; transition: width 0.5s ease; }
.care-tip { margin-top: 10rpx; font-size: 19rpx; font-weight: 700; color: #9ca3af; line-height: 1.5; }
.feed-info { margin-top: 8rpx; font-size: 27rpx; font-weight: 900; color: #374151; }
.feed-btn {
  margin-top: 16rpx;
  background: #f59e0b;
  color: #fff;
  font-size: 25rpx;
  font-weight: 900;
  border-radius: 24rpx;
  padding: 6rpx 0;
  box-shadow: 0 5rpx 0 rgba(217, 119, 6, 0.5);
}
.feed-btn-disabled { opacity: 0.4; box-shadow: none; }

.exp-tip {
  margin-top: 22rpx;
  background: #e0f2fe;
  border-radius: 26rpx;
  padding: 18rpx 24rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #0369a1;
  line-height: 1.6;
}

/* 剧情 */
.story-head { margin-top: 30rpx; display: flex; align-items: center; justify-content: space-between; padding: 0 4rpx; }
.story-title { font-size: 30rpx; font-weight: 900; color: #1f2937; }
.story-count { font-size: 21rpx; font-weight: 800; color: #7c3aed; background: #ede9fe; border-radius: 999rpx; padding: 6rpx 18rpx; }
.story-list { margin-top: 16rpx; }
.story-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  border-radius: 30rpx;
  border: 3rpx solid #ede9fe;
  background: #fff;
  padding: 22rpx 24rpx;
  margin-bottom: 14rpx;
}
.story-item.story-read { border-color: #a7f3d0; background: #ecfdf5; }
.story-item.story-locked { border-color: #f3f4f6; background: #f9fafb; }
/* 剧情章节裸 emoji 图标（去气泡芯片后直出，锁定态沿用独立灰阶类） */
.story-icon { font-size: 46rpx; line-height: 1; }
.story-icon-locked { opacity: 0.3; filter: grayscale(1); }
.story-main { flex: 1; min-width: 0; }
.story-name { font-size: 26rpx; font-weight: 900; color: #1f2937; }
.story-locked .story-name { color: #9ca3af; }
.story-status { margin-top: 4rpx; font-size: 20rpx; font-weight: 700; color: #7c3aed; }
.story-read .story-status { color: #10b981; }
.story-locked .story-status { color: #9ca3af; }
.story-new-badge { background: #8b5cf6; color: #fff; font-size: 18rpx; font-weight: 900; border-radius: 999rpx; padding: 5rpx 14rpx; }

/* ---------- 阅读器 ---------- */
.reader-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  padding: 20rpx;
  box-sizing: border-box;
}
.reader {
  width: 100%;
  max-height: 82vh;
  background: linear-gradient(180deg, #fffbeb 0%, #fff7ed 100%);
  border: 5rpx solid #fcd34d;
  border-radius: 44rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.reader-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.75);
  border-bottom: 3rpx solid #fde68a;
  padding: 22rpx 26rpx;
}
.reader-book { font-size: 20rpx; font-weight: 900; letter-spacing: 2rpx; color: #d97706; }
.reader-chapter { margin-top: 4rpx; font-size: 32rpx; font-weight: 900; color: #1f2937; }
.reader-close {
  background: #f3f4f6;
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 900;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
}
.reader-body {
  padding: 24rpx 24rpx 8rpx;
  box-sizing: border-box;
  max-height: 52vh;
  min-height: 400rpx;
}
.line { display: flex; align-items: flex-start; gap: 12rpx; margin-bottom: 18rpx; }
.line-narr { justify-content: center; }
.line-emoji { font-size: 44rpx; flex-shrink: 0; }
.line-emoji-empty { opacity: 0; }
.line-bubble {
  background: #fff;
  border-radius: 26rpx;
  padding: 16rpx 22rpx;
  max-width: 82%;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}
.line-bubble-narr { background: rgba(255, 255, 255, 0.6); text-align: center; }
.line-who { font-size: 19rpx; font-weight: 900; color: #f97316; }
.line-text { margin-top: 4rpx; font-size: 25rpx; font-weight: 700; color: #374151; line-height: 1.65; }
.line-bubble-narr .line-text { color: #6b7280; }
.reader-foot { border-top: 3rpx solid #fde68a; background: rgba(255, 255, 255, 0.75); padding: 20rpx 26rpx 26rpx; }
.reader-dots { display: flex; justify-content: center; gap: 8rpx; margin-bottom: 16rpx; }
.dot { width: 10rpx; height: 10rpx; border-radius: 999rpx; background: #e5e7eb; }
.dot-on { width: 36rpx; background: #fb923c; }
.reader-btn {
  background: #f97316;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  border-radius: 28rpx;
  padding: 8rpx 0;
  box-shadow: 0 6rpx 0 rgba(234, 88, 12, 0.5);
}
