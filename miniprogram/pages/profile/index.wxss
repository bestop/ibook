.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}
/* 云朵装饰（不挡点击） */
.page::before {
  content: '☁️';
  position: absolute;
  top: 4rpx;
  right: 30rpx;
  font-size: 52rpx;
  opacity: 0.55;
  pointer-events: none;
  animation: eggy-float 4.6s ease-in-out infinite;
}

/* ===== 签到卡 ===== */
.sign-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sign-left {
  flex: 1;
  min-width: 0;
}
.sign-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.sign-sub {
  font-size: 24rpx;
  color: #8a87b8;
  margin-top: 6rpx;
}
.sign-btn {
  padding: 32rpx 44rpx;
  font-size: 28rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ===== 每日任务 ===== */
.task {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #5b5486;
  padding: 16rpx 4rpx;
  border-bottom: 2rpx dashed #e5deff;
}
.task:last-child {
  border-bottom: none;
}
.task-done {
  color: #0e9f6e;
}
.task-coin {
  color: #e08600;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ===== 学习统计：糖果数字 ===== */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
}
.stat {
  width: 33.33%;
  text-align: center;
  padding: 18rpx 0;
  box-sizing: border-box;
}
.stat-num {
  font-size: 30rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.stat:nth-child(1) .stat-num { color: #e08600; }
.stat:nth-child(2) .stat-num { color: #f0a400; }
.stat:nth-child(3) .stat-num { color: #7c4dff; }
.stat:nth-child(4) .stat-num { color: #0e9f6e; }
.stat:nth-child(5) .stat-num { color: #f03e6b; }
.stat:nth-child(6) .stat-num { color: #1b8fd1; }
.stat-label {
  font-size: 22rpx;
  color: #8a87b8;
  margin-top: 6rpx;
}

/* ===== 成就墙：盲盒徽章 + 解锁镭射彩光 ===== */
.ach-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ach {
  position: relative;
  overflow: hidden;
  width: calc((100% - 48rpx) / 4);
  background: #f4f2fc;
  border: 3rpx solid #e5e1f5;
  border-radius: 28rpx;
  text-align: center;
  padding: 18rpx 6rpx;
  box-sizing: border-box;
  filter: grayscale(1);
  opacity: 0.55;
}
.ach-on {
  background: linear-gradient(180deg, #fffbea, #fff1bf);
  border-color: #ffd335;
  filter: none;
  opacity: 1;
  box-shadow: 0 6rpx 0 rgba(240, 164, 0, 0.2), 0 12rpx 20rpx rgba(255, 197, 61, 0.18);
  animation: eggy-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.ach-on::after {
  content: '';
  position: absolute;
  top: -20%;
  left: -60%;
  width: 60%;
  height: 140%;
  background: linear-gradient(105deg, rgba(255, 255, 255, 0) 0%, rgba(255, 153, 204, 0.16) 25%, rgba(255, 224, 102, 0.2) 45%, rgba(126, 247, 199, 0.18) 65%, rgba(140, 200, 255, 0.16) 85%, rgba(255, 255, 255, 0) 100%);
  animation: laser-sweep 4.2s ease-in-out infinite;
  pointer-events: none;
}
.ach-emoji {
  font-size: 44rpx;
}
.ach-name {
  font-size: 20rpx;
  font-weight: 800;
  color: #5b5486;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ach-prog {
  font-size: 18rpx;
  font-weight: 700;
  color: #e08600;
  margin-top: 4rpx;
}

/* ===== 设置区 ===== */
.about-card {
  margin-top: 30rpx;
  padding-top: 10rpx;
  padding-bottom: 10rpx;
}
.about-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 6rpx;
  border-bottom: 2rpx dashed #e5deff;
  border-radius: 12rpx;
}
.about-row-left {
  display: flex;
  align-items: center;
}
.about-row-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.about-row-label {
  font-size: 27rpx;
  font-weight: 800;
  color: #3d3a6e;
}
.about-row-arrow {
  font-size: 36rpx;
  font-weight: 700;
  color: #c9c4e8;
  line-height: 1;
}
.row-hover {
  background: rgba(124, 77, 255, 0.06);
}
.reset-link {
  margin: 24rpx 6rpx 10rpx;
  font-size: 23rpx;
  font-weight: 800;
  color: #f03e6b;
  text-align: center;
  padding: 16rpx;
  background: #ffe9ef;
  border-radius: 999rpx;
  box-shadow: 0 5rpx 0 rgba(240, 62, 107, 0.1);
}
.tabbar-space {
  height: 140rpx;
}
