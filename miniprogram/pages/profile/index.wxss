.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}
.sign-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sign-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #c2410c;
}
.sign-sub {
  font-size: 24rpx;
  color: #78716c;
  margin-top: 6rpx;
}
.sign-btn {
  padding: 14rpx 34rpx;
  font-size: 26rpx;
}

.task {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 27rpx;
  font-weight: 700;
  color: #57534e;
  padding: 16rpx 4rpx;
  border-bottom: 2rpx dashed #fde68a;
}
.task:last-child {
  border-bottom: none;
}
.task-done {
  color: #047857;
}
.task-coin {
  color: #b45309;
  font-weight: 900;
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}
.stat {
  width: 33.33%;
  text-align: center;
  padding: 18rpx 0;
  box-sizing: border-box;
}
.stat-num {
  font-size: 30rpx;
  font-weight: 900;
  color: #c2410c;
}
.stat-label {
  font-size: 22rpx;
  color: #78716c;
  margin-top: 6rpx;
}

.ach-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ach {
  width: calc((100% - 48rpx) / 4);
  background: rgba(255, 255, 255, 0.7);
  border: 3rpx solid #e7e5e4;
  border-radius: 24rpx;
  text-align: center;
  padding: 18rpx 6rpx;
  box-sizing: border-box;
  filter: grayscale(1);
  opacity: 0.55;
}
.ach-on {
  background: #fffbeb;
  border-color: #fbbf24;
  filter: none;
  opacity: 1;
  box-shadow: 0 6rpx 16rpx rgba(245, 158, 11, 0.18);
}
.ach-emoji {
  font-size: 44rpx;
}
.ach-name {
  font-size: 20rpx;
  font-weight: 800;
  color: #57534e;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.about-card {
  margin-top: 30rpx;
}
.about-line {
  font-size: 23rpx;
  color: #78716c;
  line-height: 1.8;
}
.reset-link {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #dc2626;
  font-weight: 800;
  text-align: center;
  padding: 12rpx;
  border: 2rpx dashed #fca5a5;
  border-radius: 16rpx;
}
.tabbar-space {
  height: 140rpx;
}
