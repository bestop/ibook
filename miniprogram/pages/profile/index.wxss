.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}
/* 云朵装饰（不挡点击） */
.page::before {
  content: '☁️';
  position: absolute;
  top: 4rpx;
  right: 30rpx;
  font-size: 52rpx;
  opacity: 0.55;
  pointer-events: none;
  animation: eggy-float 4.6s ease-in-out infinite;
}

/* ===== 签到卡：活力黄盲盒底 ===== */
.sign-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-image:
    radial-gradient(circle, rgba(255, 255, 255, 0.55) 3rpx, rgba(255, 255, 255, 0) 4rpx) 0 0 / 44rpx 44rpx,
    linear-gradient(135deg, #fffbea, #fff1bf);
  border-color: #ffe066;
  box-shadow:
    0 0 0 2rpx rgba(232, 164, 0, 0.12),
    0 14rpx 30rpx rgba(93, 74, 156, 0.1);
}
/* ===== 本周签到格（周一到周日标签行）样式已随该区块移除（Task 27） ===== */
.sign-name {
  color: #9a6b00;
}
.sign-left {
  flex: 1;
  min-width: 0;
}
.sign-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.sign-sub {
  font-size: 24rpx;
  color: #8a87b8;
  margin-top: 6rpx;
}
.sign-btn {
  padding: 32rpx 44rpx;
  font-size: 28rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ===== 每日任务 ===== */
.task {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: #5b5486;
  padding: 16rpx 4rpx;
  border-bottom: 2rpx dashed #e5deff;
}
.task:last-child {
  border-bottom: none;
}
.task-done {
  color: #0e9f6e;
}
.task-coin {
  color: #e08600;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ===== 学习统计：糖果数字 + 小底座 ===== */
.stats-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.stat {
  width: calc((100% - 24rpx) / 3);
  text-align: center;
  padding: 16rpx 4rpx;
  box-sizing: border-box;
  background: #f8f6ff;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.9),
    0 8rpx 18rpx rgba(93, 74, 156, 0.08);
}
.stat-num {
  font-size: 30rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.stat:nth-child(1) .stat-num { color: #e08600; }
.stat:nth-child(2) .stat-num { color: #f0a400; }
.stat:nth-child(3) .stat-num { color: #7c4dff; }
.stat:nth-child(4) .stat-num { color: #0e9f6e; }
.stat:nth-child(5) .stat-num { color: #f03e6b; }
.stat:nth-child(6) .stat-num { color: #1b8fd1; }
.stat-label {
  font-size: 22rpx;
  color: #8a87b8;
  margin-top: 6rpx;
}

/* ===== 成就墙：盲盒徽章 + 解锁镭射彩光 ===== */
.ach-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ach {
  position: relative;
  overflow: hidden;
  width: calc((100% - 48rpx) / 4);
  background: #f4f2fc;
  border: 3rpx dashed #d5d0ec; /* 锁定态：虚线盲盒待拆感 */
  border-radius: 28rpx;
  text-align: center;
  padding: 18rpx 6rpx;
  box-sizing: border-box;
  filter: grayscale(1);
  opacity: 0.55;
  animation: rise-in 0.3s ease-out backwards;
}
/* 交错延迟：徽章墙逐个落位（5 个后统一档；解锁态覆盖为即时弹跳） */
.ach:nth-child(1) { animation-delay: 0.02s; }
.ach:nth-child(2) { animation-delay: 0.07s; }
.ach:nth-child(3) { animation-delay: 0.12s; }
.ach:nth-child(4) { animation-delay: 0.17s; }
.ach:nth-child(n + 5) { animation-delay: 0.22s; }
.ach-on {
  background: linear-gradient(180deg, #fffbea, #fff1bf);
  border: 3rpx solid #ffd335; /* 解锁态：实线金描边 */
  filter: none;
  opacity: 1;
  box-shadow: 0 10rpx 22rpx rgba(93, 74, 156, 0.1);
  animation: eggy-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation-delay: 0s; /* 解锁庆祝不等待交错延迟 */
}
.ach-on::after {
  content: '';
  position: absolute;
  top: -20%;
  left: -60%;
  width: 60%;
  height: 140%;
  background: linear-gradient(105deg, rgba(255, 255, 255, 0) 0%, rgba(255, 153, 204, 0.16) 25%, rgba(255, 224, 102, 0.2) 45%, rgba(126, 247, 199, 0.18) 65%, rgba(140, 200, 255, 0.16) 85%, rgba(255, 255, 255, 0) 100%);
  animation: laser-sweep 4.2s ease-in-out infinite;
  pointer-events: none;
}
.ach-emoji {
  font-size: 44rpx; /* 裸 emoji 直出（图标不加气泡包裹，按需求还原 Task 21 前样式） */
  display: flex;
  justify-content: center;
}
.ach-name {
  font-size: 20rpx;
  font-weight: 800;
  color: #5b5486;
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.ach-prog {
  font-size: 18rpx;
  font-weight: 700;
  color: #e08600;
  margin-top: 4rpx;
}

/* ===== 设置区 ===== */
.about-card {
  margin-top: 30rpx;
  padding-top: 10rpx;
  padding-bottom: 10rpx;
}
.about-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 6rpx;
  border-bottom: 2rpx dashed #e5deff;
  border-radius: 12rpx;
}
.about-row-left {
  display: flex;
  align-items: center;
}
.about-row-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  font-size: 30rpx;
  background: linear-gradient(180deg, #ffffff, #f0faff);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-sizing: border-box;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.85),
    0 6rpx 14rpx rgba(93, 74, 156, 0.1);
}
.about-row-label {
  font-size: 27rpx;
  font-weight: 800;
  color: #3d3a6e;
}
.about-row-arrow {
  font-size: 36rpx;
  font-weight: 700;
  color: #c9c4e8;
  line-height: 1;
}
.row-hover {
  background: rgba(124, 77, 255, 0.06);
}
.reset-link {
  margin: 24rpx 6rpx 10rpx;
  font-size: 23rpx;
  font-weight: 800;
  color: #f03e6b;
  text-align: center;
  padding: 16rpx;
  background: #ffe9ef;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(240, 62, 107, 0.1);
}
.tabbar-space {
  height: 180rpx; /* 底部通栏导航条：图标+文字行高 + safe-area */
}

/* ===== 本周报告（借鉴聪聪学堂 WeeklyReportCard：每日分钟柱状图 + 与上周对比，与网页版同构） ===== */
.week-report-card {
  margin-top: 20rpx; /* 周条移除后由本卡自带间距衔接签到卡（与原周条 20rpx 节奏一致） */
}
.wr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.wr-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #3f3d56;
}
.wr-delta {
  font-size: 22rpx;
  font-weight: bold;
  color: #059669;
}
.wr-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 10rpx;
  height: 180rpx;
}
.wr-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.wr-track {
  width: 100%;
  height: 110rpx;
  border-radius: 12rpx;
  background: #f4f4fb;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
}
.wr-bar {
  width: 100%;
  min-height: 10rpx;
  border-radius: 12rpx;
  background: #7c6ff0;
  transition: height 0.3s ease;
}
.wr-bar-today {
  background: #f59e0b;
}
.wr-val {
  font-size: 20rpx;
  font-weight: bold;
  color: #6b7280;
}
.wr-label {
  font-size: 20rpx;
  color: #9ca3af;
}
.wr-label-today {
  color: #d97706;
  font-weight: bold;
}
.wr-stats {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
.wr-stat {
  flex: 1;
  background: #f8f8fd;
  border-radius: 16rpx;
  padding: 14rpx 0;
  text-align: center;
}
.wr-stat-num {
  font-size: 30rpx;
  font-weight: bold;
  color: #3f3d56;
}
.wr-stat-label {
  font-size: 20rpx;
  color: #9ca3af;
  margin-top: 2rpx;
}

/* ===== 用户卡：微信登录（官方头像昵称填写能力） ===== */
.user-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 20rpx;
}
.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f1ecff;
  border: 3rpx solid #fff;
  box-shadow: 0 6rpx 14rpx rgba(93, 74, 156, 0.14);
  flex-shrink: 0;
  box-sizing: border-box;
}
.user-avatar-face {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  line-height: 1;
}
.user-avatar-plus {
  background: #fff7d6; /* 待选头像：淡黄提示可点 */
}
/* chooseAvatar 按钮：彻底复位微信 button 默认外观（块级/内边距/行高全清零），仅露 96rpx 头像，固定不占宽 */
.user-avatar-btn {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  margin: 0;
  background: none;
  border: none;
  border-radius: 50%;
  line-height: 1;
  flex: none;
  overflow: hidden;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.user-avatar-btn::after {
  border: none;
}
.user-main {
  flex: 1;
  min-width: 0;
}
.user-name {
  font-size: 30rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.user-sub {
  font-size: 20rpx;
  color: #a5a1cc;
  margin-top: 4rpx;
}
.user-logout {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #8a87b8;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #f1ecff;
}
/* 完善资料 + 退出：右侧竖排胶囊列（横排会挤占昵称空间导致长昵称换行） */
.user-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  flex-shrink: 0;
}
/* 完善资料入口：与退出同规格胶囊，蓝色区分 */
.user-edit {
  font-size: 24rpx;
  font-weight: 700;
  color: #2b8fd8;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #e6f6ff;
  text-align: center;
}
/* 游客态登录钮：紧凑版活力黄 */
.user-login-btn {
  flex-shrink: 0;
  font-size: 26rpx;
  letter-spacing: 1rpx;
  padding: 14rpx 26rpx;
  line-height: 1.3;
  white-space: nowrap;
}
/* 登录表单：上下两行结构（不用 flex-wrap/百分比 basis，规避低版本 WebView 引擎差异） */
.user-form {
  width: 100%;
}
.user-form-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.user-nick-input {
  flex: 1;
  min-width: 0;
  box-sizing: border-box;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f8f8fd;
  border: 2rpx solid #e5e4f5;
  font-size: 24rpx;
  color: #3f3d56;
}
.user-form-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
/* 登录/取消：view 而非 button（无微信 UA 默认样式干扰），flex: 1 1 0% 等分整行，
   选择器带 .user-form 前缀，优先级恒压过 app.wxss 的 .btn-primary/.btn-ghost */
.user-form .user-form-btn {
  flex: 1 1 0%;
  min-width: 0;
  box-sizing: border-box;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  padding: 14rpx 0;
  line-height: 1.3;
}

