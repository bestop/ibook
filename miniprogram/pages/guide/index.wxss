.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 简介：糖果渐变卡 ===== */
.intro {
  background: linear-gradient(135deg, #fff0f8, #f1ecff);
  border: 3rpx solid #ffd3e8;
  box-shadow: 0 10rpx 0 rgba(224, 64, 127, 0.08), 0 18rpx 30rpx rgba(93, 74, 156, 0.08);
  animation: eggy-pop 0.45s ease-out;
}

.intro-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #e0407f;
  margin-bottom: 14rpx;
}

.intro-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #5b5486;
  font-weight: 600;
}

.sec {
  margin-top: 20rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.sec-text {
  font-size: 25rpx;
  line-height: 1.65;
  color: #5b5486;
  font-weight: 600;
  margin-top: 6rpx;
}

/* ===== 糖果分区卡 ===== */
.sec-amber {
  background: #fffbea;
  border: 3rpx solid #ffe066;
}
.sec-amber .sec-title {
  color: #a16207;
}

.sec-emerald {
  background: #eafcf4;
  border: 3rpx solid #86f0c8;
}
.sec-emerald .sec-title {
  color: #0e9f6e;
}

.sec-rose {
  background: #fff0f4;
  border: 3rpx solid #ffc9da;
}
.sec-rose .sec-title {
  color: #f03e6b;
}

.sec-violet {
  background: #f3efff;
  border: 3rpx solid #d9ccff;
}
.sec-violet .sec-title {
  color: #7c4dff;
}

.sec-violet-soft {
  background: rgba(243, 239, 255, 0.6);
  border: 3rpx solid #d9ccff;
}
.sec-violet-soft .sec-title {
  color: #7c4dff;
}
