.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}
/* 云朵装饰（不挡点击） */
.page::before {
  content: '☁️';
  position: absolute;
  top: 6rpx;
  right: 30rpx;
  font-size: 50rpx;
  opacity: 0.5;
  pointer-events: none;
  animation: eggy-float 5.2s ease-in-out infinite;
}

/* ===== 简介：湖蓝→淡紫糖果渐变卡 ===== */
.intro {
  background: linear-gradient(135deg, #eaf8ff, #f3efff);
  border: 3rpx solid #c9e9ff;
  box-shadow: 0 10rpx 0 rgba(27, 143, 209, 0.08), 0 24rpx 44rpx rgba(93, 74, 156, 0.1);
  animation: eggy-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.intro-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #1b8fd1;
  margin-bottom: 14rpx;
}

.intro-text {
  font-size: 26rpx;
  line-height: 1.7;
  color: #5b5486;
  font-weight: 600;
}

.sec {
  margin-top: 20rpx;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 900;
  margin-bottom: 12rpx;
}

.sec-text {
  font-size: 25rpx;
  line-height: 1.65;
  color: #5b5486;
  font-weight: 600;
  margin-top: 6rpx;
}

/* ===== 糖果分区卡：活力黄/薄荷/浅粉/淡紫 ===== */
.sec-amber {
  background: #fffbea;
  border: 3rpx solid #ffe066;
}
.sec-amber .sec-title {
  color: #a16207;
}

.sec-emerald {
  background: #eafcf4;
  border: 3rpx solid #a8f0d4;
}
.sec-emerald .sec-title {
  color: #0e9f6e;
}

.sec-rose {
  background: #fff0f4;
  border: 3rpx solid #ffd9e8;
}
.sec-rose .sec-title {
  color: #f03e6b;
}

.sec-violet {
  background: #f3efff;
  border: 3rpx solid #e6dcff;
}
.sec-violet .sec-title {
  color: #7c4dff;
}

.sec-violet-soft {
  background: rgba(243, 239, 255, 0.6);
  border: 3rpx solid #e6dcff;
}
.sec-violet-soft .sec-title {
  color: #7c4dff;
}
