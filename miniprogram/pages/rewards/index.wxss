.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
  position: relative;
}
/* 云朵装饰（不挡点击） */
.page::before {
  content: '☁️';
  position: absolute;
  top: 4rpx;
  right: 30rpx;
  font-size: 52rpx;
  opacity: 0.55;
  pointer-events: none;
  animation: eggy-float 4.8s ease-in-out infinite;
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.head-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.head-sub {
  font-size: 22rpx;
  color: #8a87b8;
  margin-top: 6rpx;
}
.coin-badge {
  background: #ffe066;
  border: 3rpx solid #fff;
  color: #8a5a00;
  font-size: 30rpx;
  font-weight: 900;
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  box-shadow: 0 6rpx 0 rgba(138, 90, 0, 0.16);
}

/* ===== 奖励列表：盲盒包装 + 镭射彩虹闪 ===== */
.reward-card {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 16rpx;
}
.reward-card::after {
  content: '';
  position: absolute;
  top: -20%;
  left: -60%;
  width: 60%;
  height: 140%;
  background: linear-gradient(105deg, rgba(255, 255, 255, 0) 0%, rgba(255, 153, 204, 0.12) 25%, rgba(255, 224, 102, 0.16) 45%, rgba(126, 247, 199, 0.14) 65%, rgba(140, 200, 255, 0.12) 85%, rgba(255, 255, 255, 0) 100%);
  animation: laser-sweep 4.2s ease-in-out infinite;
  pointer-events: none;
}
.reward-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 84rpx;
  height: 84rpx;
  font-size: 52rpx;
  background: linear-gradient(135deg, #fff3f9, #eaf8ff);
  border: 3rpx solid #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 0 rgba(148, 180, 255, 0.16);
  flex-shrink: 0;
  box-sizing: border-box;
}
.reward-main {
  flex: 1;
  min-width: 0;
}
.reward-name {
  font-size: 29rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.reward-desc {
  font-size: 22rpx;
  color: #8a87b8;
  margin-top: 4rpx;
}
.reward-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.reward-cost {
  font-size: 24rpx;
  font-weight: 900;
  color: #e08600;
}
.reward-btn {
  padding: 10rpx 30rpx;
  font-size: 25rpx;
}
.reward-del {
  font-size: 20rpx;
  color: #c9c4e8;
  padding: 2rpx 10rpx;
}

.add-btn {
  margin: 8rpx 0 20rpx;
}
.form-card {
  margin-bottom: 20rpx;
}
.form-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.form-label {
  width: 90rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #3d3a6e;
}
.form-input {
  flex: 1;
  background: #faf8ff;
  border: 3rpx solid #e5deff;
  border-radius: 24rpx;
  padding: 14rpx 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.form-emoji {
  flex: 0 0 140rpx;
  text-align: center;
}

/* ===== 券包：镭射票券 ===== */
.coupon {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding: 22rpx;
}
.coupon::after {
  content: '';
  position: absolute;
  top: -20%;
  left: -60%;
  width: 60%;
  height: 140%;
  background: linear-gradient(105deg, rgba(255, 255, 255, 0) 0%, rgba(255, 153, 204, 0.12) 25%, rgba(255, 224, 102, 0.16) 45%, rgba(126, 247, 199, 0.14) 65%, rgba(140, 200, 255, 0.12) 85%, rgba(255, 255, 255, 0) 100%);
  animation: laser-sweep 4.2s ease-in-out infinite;
  animation-delay: 0.8s;
  pointer-events: none;
}
.coupon-done {
  opacity: 0.6;
}
.coupon-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.coupon-emoji {
  font-size: 44rpx;
}
.coupon-name {
  font-size: 27rpx;
  font-weight: 800;
  color: #3d3a6e;
}
.coupon-time {
  font-size: 20rpx;
  color: #a5a1cc;
  margin-top: 4rpx;
}
.coupon-ok {
  color: #0e9f6e;
  font-weight: 900;
  font-size: 24rpx;
}
.coupon-btn {
  padding: 8rpx 24rpx;
  font-size: 22rpx;
}
.tabbar-space {
  height: 140rpx;
}
