.page {
  padding: 40rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}
.result-card {
  text-align: center;
  padding: 60rpx 36rpx;
}
.result-emoji {
  font-size: 110rpx;
}
.result-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #c2410c;
  margin-top: 16rpx;
}
.result-sub {
  font-size: 24rpx;
  color: #78716c;
  margin-top: 8rpx;
}
.result-stars {
  margin: 30rpx 0 6rpx;
}
.big-star {
  font-size: 84rpx;
  color: #e7e5e4;
  margin: 0 10rpx;
}
.big-star-on {
  color: #f59e0b;
  text-shadow: 0 6rpx 16rpx rgba(245, 158, 11, 0.4);
}
.result-stats {
  display: flex;
  justify-content: center;
  gap: 50rpx;
  margin: 36rpx 0 10rpx;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #ea580c;
}
.stat-label {
  font-size: 22rpx;
  color: #78716c;
  margin-top: 4rpx;
}
.result-note {
  background: #fef3c7;
  color: #b45309;
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 12rpx 20rpx;
  margin: 16rpx 0 0;
}
.result-btn {
  margin-top: 24rpx;
}
