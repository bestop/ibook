.page {
  padding: 40rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}
.result-card {
  text-align: center;
  padding: 60rpx 36rpx;
  animation: eggy-pop 0.45s ease-out;
}
.result-emoji {
  font-size: 110rpx;
  animation: eggy-wobble 2.6s ease-in-out infinite;
}
.result-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #3d3a6e;
  margin-top: 16rpx;
}
.result-sub {
  font-size: 24rpx;
  color: #8a87b8;
  margin-top: 8rpx;
}
.result-stars {
  margin: 30rpx 0 6rpx;
}
.big-star {
  font-size: 84rpx;
  color: #d9d6f2;
  margin: 0 10rpx;
}
.big-star-on {
  color: #ffc53d;
  text-shadow: 0 6rpx 16rpx rgba(255, 197, 61, 0.5);
  animation: eggy-pop 0.4s ease-out;
}
.result-stats {
  display: flex;
  justify-content: center;
  gap: 50rpx;
  margin: 36rpx 0 10rpx;
}
.stat {
  text-align: center;
}
.stat-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #ff4d8d;
}
.stat-label {
  font-size: 22rpx;
  color: #8a87b8;
  margin-top: 4rpx;
}
.result-note {
  background: #fff1bf;
  color: #a16207;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  margin: 16rpx 0 0;
}
.result-btn {
  margin-top: 24rpx;
}
