.page {
  padding: 40rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}
.result-card {
  position: relative;
  overflow: hidden;
  text-align: center;
  padding: 60rpx 36rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    0 0 0 2rpx rgba(148, 180, 255, 0.1),
    0 18rpx 40rpx rgba(93, 74, 156, 0.12);
  animation: eggy-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}
/* 派对纸屑（纯装饰） */
.result-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-image:
    radial-gradient(circle at 12% 18%, rgba(62, 198, 255, 0.2) 0, rgba(62, 198, 255, 0.2) 7rpx, rgba(0, 0, 0, 0) 8rpx),
    radial-gradient(circle at 86% 14%, rgba(255, 123, 169, 0.18) 0, rgba(255, 123, 169, 0.18) 6rpx, rgba(0, 0, 0, 0) 7rpx),
    radial-gradient(circle at 78% 66%, rgba(255, 211, 53, 0.2) 0, rgba(255, 211, 53, 0.2) 7rpx, rgba(0, 0, 0, 0) 8rpx),
    radial-gradient(circle at 14% 78%, rgba(167, 139, 250, 0.18) 0, rgba(167, 139, 250, 0.18) 6rpx, rgba(0, 0, 0, 0) 7rpx),
    radial-gradient(circle at 50% 88%, rgba(62, 213, 152, 0.14) 0, rgba(62, 213, 152, 0.14) 5rpx, rgba(0, 0, 0, 0) 6rpx);
  pointer-events: none;
}
.result-emoji {
  font-size: 110rpx;
  line-height: 1.1;
  animation: eggy-wobble 2.6s ease-in-out infinite;
  text-shadow: 0 12rpx 28rpx rgba(255, 197, 61, 0.45); /* 金色光晕 */
  filter: drop-shadow(0 6rpx 0 rgba(255, 255, 255, 0.9));
}
.result-title {
  font-size: 40rpx;
  font-weight: 900;
  color: #3d3a6e;
  margin-top: 16rpx;
}
.result-sub {
  font-size: 24rpx;
  color: #8a87b8;
  margin-top: 8rpx;
}
.result-stars {
  margin: 30rpx 0 6rpx;
  display: flex;
  justify-content: center;
}
.big-star {
  font-size: 84rpx;
  color: #d9d6f2;
  margin: 0 10rpx;
}
.big-star-on {
  color: #ffc53d;
  text-shadow: 0 6rpx 16rpx rgba(255, 197, 61, 0.5);
  animation: eggy-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
}
/* 星星逐个弹出：左→中→右节奏感 */
.result-stars .big-star:nth-child(1) { animation-delay: 0.05s; }
.result-stars .big-star:nth-child(2) { animation-delay: 0.25s; }
.result-stars .big-star:nth-child(3) { animation-delay: 0.45s; }
/* 数据小底座：白描边软胶托盘 */
.result-stats {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: 36rpx 0 10rpx;
}
.stat {
  flex: 1;
  max-width: 200rpx;
  text-align: center;
  background: #f8f6ff;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  padding: 18rpx 10rpx;
  box-sizing: border-box;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.9),
    0 8rpx 18rpx rgba(93, 74, 156, 0.1);
}
.stat-num {
  font-size: 38rpx;
  font-weight: 900;
  color: #1b8fd1;
}
.stat-label {
  font-size: 22rpx;
  color: #8a87b8;
  margin-top: 4rpx;
}
.result-note {
  background: #fff1bf;
  color: #a16207;
  font-size: 24rpx;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  width: fit-content; /* 自适应包裹文字并居中，两条提示各自成行 */
  max-width: 100%;
  box-sizing: border-box;
  margin: 16rpx auto 0;
}
.result-btn {
  margin-top: 24rpx;
}
.result-note-pet {
  background: #e0f2fe;
  color: #0369a1;
}
.result-note-pet-muted {
  background: #f1f5f9;
  color: #64748b;
}

/* ===== 通关撒花（借鉴聪聪学堂 ConfettiCanvas，纯 CSS 实现，零 JS 开销） ===== */
.confetti-layer {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  height: 100vh;
  z-index: 80;
  pointer-events: none;
  overflow: hidden;
}
.confetti {
  position: absolute;
  top: -70rpx;
  font-size: 40rpx;
  animation: confetti-fall 2.6s ease-in forwards;
}
/* 6 组横向漂移轨迹，错落下落 */
.confetti-0 { animation-name: confetti-fall-0; }
.confetti-1 { animation-name: confetti-fall-1; }
.confetti-2 { animation-name: confetti-fall-2; }
.confetti-3 { animation-name: confetti-fall-3; }
.confetti-4 { animation-name: confetti-fall-4; }
.confetti-5 { animation-name: confetti-fall-5; }
@keyframes confetti-fall-0 {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(105vh) translateX(30rpx) rotate(360deg); opacity: 0.2; }
}
@keyframes confetti-fall-1 {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(105vh) translateX(-40rpx) rotate(-300deg); opacity: 0.2; }
}
@keyframes confetti-fall-2 {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(105vh) translateX(60rpx) rotate(280deg); opacity: 0.15; }
}
@keyframes confetti-fall-3 {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(105vh) translateX(-25rpx) rotate(320deg); opacity: 0.2; }
}
@keyframes confetti-fall-4 {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(105vh) translateX(45rpx) rotate(-360deg); opacity: 0.15; }
}
@keyframes confetti-fall-5 {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(105vh) translateX(-55rpx) rotate(300deg); opacity: 0.2; }
}
