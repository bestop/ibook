.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 4rpx 20rpx;
}
.header-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.logo {
  font-size: 44rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 900;
  color: #ea580c;
}

.today-card {
  margin-bottom: 20rpx;
}
.today-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.today-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #9a3412;
}
.progress-track {
  height: 20rpx;
  background: #fef3c7;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #f97316, #f59e0b);
  border-radius: 999rpx;
  transition: width 0.4s;
}

.picker-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.picker-btn {
  background: #fff;
  border: 3rpx solid #c7d2fe;
  color: #4338ca;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  font-weight: 800;
  white-space: nowrap;
}

.subject-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.subject-emoji {
  font-size: 64rpx;
}
.subject-main {
  flex: 1;
  min-width: 0;
}
.subject-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.subject-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #c2410c;
}
.subject-tagline {
  font-size: 24rpx;
  color: #78716c;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subject-meta {
  font-size: 20rpx;
  color: #a8a29e;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subject-go {
  color: #ea580c;
  font-weight: 800;
  font-size: 26rpx;
}

.error-box {
  text-align: center;
  padding: 60rpx 30rpx;
}
.error-emoji {
  font-size: 70rpx;
}
.error-text {
  color: #b45309;
  font-weight: 700;
  margin: 20rpx 0;
}
.retry-btn {
  margin: 10rpx 60rpx;
}
.error-hint {
  font-size: 22rpx;
  color: #a8a29e;
}

.offline-tip {
  background: #fef3c7;
  color: #b45309;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

.back-btn {
  margin: 10rpx 60rpx;
}
.tabbar-space {
  height: 140rpx;
}
