.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 首页 Hero：蛋仔天空 + 气泡云朵装饰 ===== */
.hero {
  position: relative;
  text-align: center;
  padding: 28rpx 8rpx 12rpx;
}
.hero-cloud,
.hero-star,
.hero-rainbow,
.hero-egg {
  position: absolute;
}
.hero-cloud {
  left: 16rpx;
  top: 8rpx;
  font-size: 44rpx;
  animation: eggy-float 3.6s ease-in-out infinite;
}
.hero-star {
  right: 20rpx;
  top: 20rpx;
  font-size: 40rpx;
  animation: eggy-float 3.6s ease-in-out infinite;
  animation-delay: 1.2s;
}
.hero-rainbow {
  left: 44rpx;
  top: 78rpx;
  font-size: 42rpx;
  animation: eggy-wobble 3.8s ease-in-out infinite;
}
.hero-egg {
  right: 52rpx;
  top: 96rpx;
  font-size: 38rpx;
  animation: eggy-float 3s ease-in-out infinite;
  animation-delay: 0.6s;
}
/* 漂浮小气泡（纯装饰，不挡点击） */
.hero::before {
  content: '';
  position: absolute;
  left: 120rpx;
  top: 150rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.95), rgba(255, 182, 213, 0.45));
  opacity: 0.8;
  animation: eggy-float 4s ease-in-out infinite;
  pointer-events: none;
}
.hero::after {
  content: '';
  position: absolute;
  right: 118rpx;
  top: 62rpx;
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.95), rgba(150, 220, 255, 0.5));
  opacity: 0.8;
  animation: eggy-float 3.2s ease-in-out infinite;
  animation-delay: 0.8s;
  pointer-events: none;
}
@keyframes island-bob {
  0%,
  100% {
    transform: translateY(0) rotate(-3deg);
  }
  50% {
    transform: translateY(-18rpx) rotate(3deg);
  }
}
.hero-bubble {
  position: relative;
  display: inline-block;
  max-width: 100%;
  box-sizing: border-box;
  background: #fff;
  border: 4rpx solid #a9e2ff;
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #1289c9;
  box-shadow: 0 8rpx 0 rgba(43, 179, 245, 0.18);
  animation: eggy-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.hero-bubble::after {
  content: '';
  position: absolute;
  left: 80rpx;
  bottom: -16rpx;
  width: 26rpx;
  height: 26rpx;
  background: #fff;
  border-right: 4rpx solid #a9e2ff;
  border-bottom: 4rpx solid #a9e2ff;
  transform: rotate(45deg);
}
.hero-island {
  display: block;
  margin-top: 36rpx;
  font-size: 130rpx;
  line-height: 1.1;
  animation: island-bob 3s ease-in-out infinite;
}
.hero-title {
  margin-top: 10rpx;
  font-size: 62rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-indent: 2rpx; /* 补偿尾字 letter-spacing，渐变文字视觉居中 */
  background: linear-gradient(90deg, #2bb3f5, #8b5cf6 50%, #ff7ba9);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #6b5bb8;
}
.hero-chips {
  margin-top: 26rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
}
/* 贴纸胶囊：白描边 + 微倾斜 */
.chip {
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 25rpx;
  font-weight: 900;
  border: 4rpx solid #fff;
  box-shadow: 0 6rpx 0 rgba(61, 58, 110, 0.1), 0 10rpx 18rpx rgba(61, 58, 110, 0.08);
}
.hero-chips .chip:nth-child(1) { transform: rotate(-2deg); }
.hero-chips .chip:nth-child(2) { transform: rotate(1.5deg); }
.hero-chips .chip:nth-child(3) { transform: rotate(-1deg); }
.chip.gold {
  background: #ffe066;
  color: #8a5a00;
}
.chip.fire {
  background: #a8f0d4;
  color: #0b7a55;
}
.chip.wrong {
  background: #ffd9e8;
  color: #c21e6a;
}

/* ===== 分享小胶囊：贴字最小宽（仅容「分享」二字），今日卡标题行内「0/20 分钟」右侧 ===== */
.today-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.share-fab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 4rpx; /* 贴字收窄：仅容「分享」二字，宽约 58rpx */
  min-width: 0; /* 兜底排除任何默认最小宽 */
  line-height: 1.3;
  font-size: 22rpx;
  font-weight: 900;
  color: #8a5a00;
  background: linear-gradient(180deg, #ffe066 0%, #ffc93c 100%);
  border: 3rpx solid #fff;
  border-radius: 999rpx;
  box-sizing: border-box;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.45),
    0 4rpx 0 rgba(232, 164, 0, 0.5),
    0 8rpx 14rpx rgba(255, 201, 60, 0.3);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: share-sway 3s ease-in-out infinite;
}
.share-fab:active {
  animation: none; /* 按压时暂停摇晃，让位给缩放反馈 */
  transform: scale(0.9);
}
.share-fab::after {
  border: none; /* 重置微信 button 默认描边 */
}
/* 轻微摇晃：小幅摆动后停顿，像招手的小贴纸 */
@keyframes share-sway {
  0%,
  16%,
  100% { transform: rotate(0deg); }
  26% { transform: rotate(-6deg); }
  38% { transform: rotate(5deg); }
  50% { transform: rotate(-3deg); }
  62% { transform: rotate(2deg); }
  76% { transform: rotate(0deg); }
}
@media (prefers-reduced-motion: reduce) {
  .share-fab {
    animation: none;
  }
}

/* ===== 今日 20 分钟 ===== */
.today-card {
  margin-bottom: 20rpx;
  overflow: hidden; /* 外框硬保证：任何字况下内容不越出卡片边框 */
}
.today-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.today-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #3d3a6e;
  white-space: nowrap; /* 标题、时长胶囊、分享按钮一行排布保底 */
  min-width: 0;
  overflow: hidden; /* 极端窄字况下标题自动省略，把行宽让给胶囊与按钮 */
  text-overflow: ellipsis;
}
.progress-track {
  height: 22rpx;
  background: #f1ecff;
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow: inset 0 3rpx 6rpx rgba(93, 74, 156, 0.12);
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffd335, #3ec6ff);
  border-radius: 999rpx;
  box-shadow: inset 0 3rpx 0 rgba(255, 255, 255, 0.4);
  transition: width 0.4s;
}

/* ===== 三维选择器：湖蓝果冻胶囊 ===== */
.picker-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.picker-btn {
  background: #fff;
  border: 3rpx solid #bde7ff;
  color: #1b8fd1;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  font-weight: 900;
  white-space: nowrap;
  box-shadow: 0 6rpx 0 #d8eeff;
}

/* ===== 科目岛卡片：软塑胶贴纸盒 ===== */
.subject-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.subject-card:active {
  transform: scale(0.96);
}
.subject-left {
  flex-shrink: 0;
}
.subject-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  font-size: 56rpx;
  background: linear-gradient(135deg, #fff3f9, #eaf8ff);
  border: 3rpx solid #fff;
  border-radius: 30rpx;
  box-shadow: 0 6rpx 0 rgba(148, 180, 255, 0.16);
  flex-shrink: 0;
  box-sizing: border-box;
}
.subject-main {
  flex: 1;
  min-width: 0;
}
.subject-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.subject-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.subject-tagline {
  font-size: 24rpx;
  color: #8a87b8;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subject-meta {
  font-size: 20rpx;
  color: #a5a1cc;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subject-go {
  background: #ffe066;
  color: #8a5a00;
  border: 3rpx solid #fff;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 900;
  font-size: 26rpx;
  box-shadow: 0 6rpx 0 rgba(232, 164, 0, 0.22);
}

/* ===== 错误 / 离线态 ===== */
.error-box {
  text-align: center;
  padding: 60rpx 30rpx;
}
.error-emoji {
  font-size: 70rpx;
}
.error-text {
  color: #f03e6b;
  font-weight: 800;
  margin: 20rpx 0;
}
.retry-btn {
  margin: 10rpx 60rpx;
}
.error-hint {
  font-size: 22rpx;
  color: #a5a1cc;
}

.tabbar-space {
  height: 140rpx;
}
