.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 首页 Hero：参考图风格——左侧大标题 + 问候语，右侧小岛插画
   （点小岛分享，原太阳钮下线；云朵彩蛋与星星装饰保留） ===== */
.hero {
  position: relative;
  padding: 44rpx 8rpx 4rpx;
}
.hero-cloud,
.hero-star {
  position: absolute;
}
.hero-cloud {
  /* 隐藏彩蛋热区：40rpx 对称内边距扩大可点面积，坐标同步负偏移补偿，
     云朵视觉位置与原版完全一致（left 16-40=-24 / top 8-40=-32） */
  left: -24rpx;
  top: -32rpx;
  padding: 40rpx;
  font-size: 44rpx;
  animation: eggy-float 3.6s ease-in-out infinite;
}
.hero-star {
  right: 20rpx;
  top: 0;
  font-size: 36rpx;
  animation: eggy-float 3.6s ease-in-out infinite;
  animation-delay: 1.2s;
}
@keyframes island-bob {
  0%,
  100% {
    transform: translateY(0) rotate(-3deg);
  }
  50% {
    transform: translateY(-18rpx) rotate(3deg);
  }
}
/* 左右分栏：左标题问候，右小岛 */
.hero-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.hero-left {
  flex: 1;
  min-width: 0;
  padding-top: 16rpx;
}
.hero-title {
  font-size: 58rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  color: #2e3a52;
}
.hero-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #5b6f86;
  line-height: 1.5;
}
/* ===== 小岛分享钮：小岛场景即按钮（透明触发壳压制微信默认样式，与旧太阳钮同方案）
   场景精简（按需求）：⛰️山落在岛上、挡住岛上的树（z 序高于主岛），其余树/浪花已移除,
   整体随 island-bob 一起漂浮，海面椭圆影保留 */
.island-share {
  position: relative;
  flex-shrink: 0;
  width: 210rpx !important;
  height: 176rpx !important;
  min-width: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  border: none;
  border-radius: 0;
  line-height: 1 !important;
  overflow: visible;
}
.island-share::after {
  border: none; /* 重置微信 button 默认描边 */
}
.hero-island {
  position: relative;
  display: block;
  width: 100%;
  height: 100%;
  animation: island-bob 3s ease-in-out infinite;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.hero-island text {
  position: absolute;
  line-height: 1;
}
/* 主岛：场景主体 */
.isl-main {
  left: 50%;
  bottom: 4rpx;
  font-size: 124rpx;
  transform: translateX(-50%);
  z-index: 1;
}
/* 山已按需求移除（Task 28）：hero 场景仅保留主岛 */
/* 小岛底座：海面椭圆影随小岛场景一起飘 */
.hero-island::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -10rpx;
  width: 184rpx;
  height: 28rpx;
  margin-left: -92rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(43, 179, 245, 0.28), rgba(43, 179, 245, 0) 70%);
  z-index: -1;
}
.island-share:active .hero-island {
  transform: scale(0.9); /* 按压缩放反馈 */
  animation: none;
}

/* ===== 今日 20 分钟 ===== */
.today-card {
  margin-top: 24rpx;
  margin-bottom: 20rpx;
  overflow: hidden; /* 外框硬保证：任何字况下内容不越出卡片边框 */
}
/* 三数据行：金币 / 连续 / 错题（参考图样式：竖分隔线三等分，同时是快捷入口） */
.stat-row {
  display: flex;
  align-items: center;
}
.stat-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
  color: #3c4656;
  letter-spacing: 1rpx;
  white-space: nowrap;
}
.stat-divider {
  width: 2rpx;
  height: 36rpx;
  background: #edf0f4;
  border-radius: 2rpx;
  flex-shrink: 0;
}
.stat-split {
  height: 2rpx;
  background: #f0f3f7;
  border-radius: 2rpx;
  margin: 18rpx 0 20rpx;
}
/* 快捷入口：可点状态，按压轻缩反馈 */
.chip-link {
  transition: transform 0.15s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.chip-link:active {
  transform: scale(0.9);
}
/* ===== 今日 20 分钟标题行（标题 + 进度标签；今日任务胶囊已移除，保留达成庆祝） ===== */
.today-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.today-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #3d3a6e;
  white-space: nowrap; /* 一行排布 */
  flex-shrink: 0; /* 标题完整显示：不缩不省略 */
}
.progress-track {
  position: relative;
  height: 26rpx;
  background: #f1ecff;
  border: 3rpx solid #fff;
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow:
    inset 0 3rpx 6rpx rgba(93, 74, 156, 0.14),
    0 6rpx 14rpx rgba(148, 180, 255, 0.16);
}
/* 糖果条纹流动进度：活力黄→湖蓝渐变 + 白色斜纹 */
.progress-fill {
  height: 100%;
  background-image:
    repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.4) 0 12rpx, rgba(255, 255, 255, 0) 12rpx 24rpx),
    linear-gradient(90deg, #ffd335, #3ec6ff);
  border-radius: 999rpx;
  box-shadow: inset 0 3rpx 0 rgba(255, 255, 255, 0.45);
  transition: width 0.4s;
  animation: stripe-move 1.2s linear infinite;
}

/* ===== 三维选择器：三等分一行，参考图白色药丸按钮 ===== */
.picker-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.picker-cell {
  flex: 1;
  min-width: 0;
}
.picker-btn {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  background: #ffffff;
  border: 2rpx solid #eef2f6;
  color: #3c4656;
  border-radius: 999rpx;
  padding: 14rpx 8rpx;
  font-size: 25rpx;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-shadow: 0 6rpx 16rpx rgba(43, 90, 138, 0.08);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease;
}
.picker-btn:active {
  transform: translateY(3rpx) scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(43, 90, 138, 0.06);
}

/* ===== 分区标题已按需求移除：筛选药丸直接衔接科目岛列表 ===== */

/* 科目岛列表容器（与筛选药丸留出段间距） */
.subject-list {
  min-width: 0;
  margin-top: 30rpx;
}
/* 空态卡与列表同间距 */
.card.empty-tip {
  margin-top: 30rpx;
}

/* ===== 科目岛卡片：软塑胶贴纸盒（交错浮起入场） ===== */
.subject-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: rise-in 0.3s ease-out backwards;
}
/* 交错延迟：在 .subject-list 容器内局部计数（首屏 4 张内逐个浮现，其后统一档） */
.subject-card:nth-child(1) { animation-delay: 0.02s; }
.subject-card:nth-child(2) { animation-delay: 0.07s; }
.subject-card:nth-child(3) { animation-delay: 0.12s; }
.subject-card:nth-child(4) { animation-delay: 0.17s; }
.subject-card:nth-child(n + 5) { animation-delay: 0.22s; }
.subject-card:active {
  transform: scale(0.96);
}
.subject-left {
  flex-shrink: 0;
}
.subject-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  font-size: 56rpx;
  background: linear-gradient(135deg, #fff3f9, #eaf8ff);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 30rpx;
  box-shadow:
    inset 0 5rpx 0 rgba(255, 255, 255, 0.85),
    0 8rpx 18rpx rgba(93, 74, 156, 0.1);
  flex-shrink: 0;
  box-sizing: border-box;
}
.subject-main {
  flex: 1;
  min-width: 0;
}
.subject-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.subject-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.subject-tagline {
  font-size: 24rpx;
  color: #8a87b8;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subject-meta {
  font-size: 20rpx;
  color: #a5a1cc;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 出发按钮：活力黄豆荚果冻（底色按需求保留） */
.subject-go {
  background: linear-gradient(180deg, #ffe066 0%, #ffc93c 100%);
  color: #8a5a00;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 900;
  font-size: 26rpx;
  white-space: nowrap;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.5),
    0 4rpx 0 rgba(232, 164, 0, 0.28),
    0 10rpx 20rpx rgba(255, 201, 60, 0.24);
}

/* ===== 错误 / 离线态 ===== */
.error-box {
  text-align: center;
  padding: 60rpx 30rpx;
}
.error-emoji {
  font-size: 70rpx;
}
.error-text {
  color: #f03e6b;
  font-weight: 800;
  margin: 20rpx 0;
}
.retry-btn {
  margin: 10rpx 60rpx;
}
.error-hint {
  font-size: 22rpx;
  color: #a5a1cc;
}

.tabbar-space {
  height: 180rpx; /* 底部通栏导航条：图标+文字行高 + safe-area */
}

/* ===== 每日任务全部达成庆祝徽标（闯关 + 20 分钟双达标触发，与网页版同构） ===== */
.task-all-done {
  margin: 12rpx 0 0; /* 卡内全宽 */
  padding: 14rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fef3c7, #fde68a);
  color: #92400e;
  font-size: 24rpx;
  font-weight: bold;
  text-align: center;
}
