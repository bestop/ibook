.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 首页 Hero（与网页版一致） ===== */
.hero {
  position: relative;
  text-align: center;
  padding: 28rpx 8rpx 12rpx;
}
.hero-cloud,
.hero-star {
  position: absolute;
  top: 8rpx;
  font-size: 44rpx;
  animation: heroFloat 3.6s ease-in-out infinite;
}
.hero-cloud {
  left: 16rpx;
}
.hero-star {
  right: 20rpx;
  top: 20rpx;
  font-size: 40rpx;
  animation-delay: 1.2s;
}
@keyframes heroFloat {
  0%,
  100% {
    transform: translateY(0) rotate(0deg);
  }
  50% {
    transform: translateY(-10rpx) rotate(6deg);
  }
}
.hero-bubble {
  position: relative;
  display: inline-block;
  background: #fff;
  border: 4rpx solid #fed7aa;
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #f97316;
  box-shadow: 0 8rpx 0 rgba(251, 146, 60, 0.2);
}
.hero-bubble::after {
  content: '';
  position: absolute;
  left: 80rpx;
  bottom: -16rpx;
  width: 26rpx;
  height: 26rpx;
  background: #fff;
  border-right: 4rpx solid #fed7aa;
  border-bottom: 4rpx solid #fed7aa;
  transform: rotate(45deg);
}
.hero-island {
  display: block;
  margin-top: 36rpx;
  font-size: 130rpx;
  line-height: 1.1;
  animation: heroBob 3s ease-in-out infinite;
}
@keyframes heroBob {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-18rpx);
  }
}
.hero-title {
  margin-top: 10rpx;
  font-size: 62rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  background: linear-gradient(90deg, #f97316, #f59e0b, #f43f5e);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #d97706;
}
.hero-chips {
  margin-top: 26rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
}
.chip {
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 25rpx;
  font-weight: 900;
}
.chip.gold {
  background: #fef3c7;
  color: #b45309;
}
.chip.fire {
  background: #d1fae5;
  color: #047857;
}
.chip.wrong {
  background: #ffe4e6;
  color: #be123c;
}

.today-card {
  margin-bottom: 20rpx;
}
.today-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.today-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #9a3412;
}
.progress-track {
  height: 20rpx;
  background: #fef3c7;
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #f97316, #f59e0b);
  border-radius: 999rpx;
  transition: width 0.4s;
}

.picker-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.guide-btn {
  background: #f5f3ff;
  border-color: #ddd6fe;
  color: #6d28d9;
}
.picker-btn {
  background: #fff;
  border: 3rpx solid #c7d2fe;
  color: #4338ca;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  font-weight: 800;
  white-space: nowrap;
}

.subject-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.subject-emoji {
  font-size: 64rpx;
}
.subject-main {
  flex: 1;
  min-width: 0;
}
.subject-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.subject-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #c2410c;
}
.subject-tagline {
  font-size: 24rpx;
  color: #78716c;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subject-meta {
  font-size: 20rpx;
  color: #a8a29e;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subject-go {
  color: #ea580c;
  font-weight: 800;
  font-size: 26rpx;
}

.error-box {
  text-align: center;
  padding: 60rpx 30rpx;
}
.error-emoji {
  font-size: 70rpx;
}
.error-text {
  color: #b45309;
  font-weight: 700;
  margin: 20rpx 0;
}
.retry-btn {
  margin: 10rpx 60rpx;
}
.error-hint {
  font-size: 22rpx;
  color: #a8a29e;
}

.offline-tip {
  background: #fef3c7;
  color: #b45309;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

.back-btn {
  margin: 10rpx 60rpx;
}
.tabbar-space {
  height: 140rpx;
}
