.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 首页 Hero：蛋仔天空 ===== */
.hero {
  position: relative;
  text-align: center;
  padding: 28rpx 8rpx 12rpx;
}
.hero-cloud,
.hero-star,
.hero-rainbow,
.hero-egg {
  position: absolute;
}
.hero-cloud {
  left: 16rpx;
  top: 8rpx;
  font-size: 44rpx;
  animation: eggy-float 3.6s ease-in-out infinite;
}
.hero-star {
  right: 20rpx;
  top: 20rpx;
  font-size: 40rpx;
  animation: eggy-float 3.6s ease-in-out infinite;
  animation-delay: 1.2s;
}
.hero-rainbow {
  left: 44rpx;
  top: 78rpx;
  font-size: 42rpx;
  animation: eggy-wobble 3.8s ease-in-out infinite;
}
.hero-egg {
  right: 52rpx;
  top: 96rpx;
  font-size: 38rpx;
  animation: eggy-float 3s ease-in-out infinite;
  animation-delay: 0.6s;
}
@keyframes island-bob {
  0%,
  100% {
    transform: translateY(0) rotate(-3deg);
  }
  50% {
    transform: translateY(-18rpx) rotate(3deg);
  }
}
.hero-bubble {
  position: relative;
  display: inline-block;
  background: #fff;
  border: 4rpx solid #ffc3dc;
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #ff4d8d;
  box-shadow: 0 8rpx 0 rgba(255, 77, 141, 0.18);
  animation: eggy-pop 0.5s ease-out;
}
.hero-bubble::after {
  content: '';
  position: absolute;
  left: 80rpx;
  bottom: -16rpx;
  width: 26rpx;
  height: 26rpx;
  background: #fff;
  border-right: 4rpx solid #ffc3dc;
  border-bottom: 4rpx solid #ffc3dc;
  transform: rotate(45deg);
}
.hero-island {
  display: block;
  margin-top: 36rpx;
  font-size: 130rpx;
  line-height: 1.1;
  animation: island-bob 3s ease-in-out infinite;
}
.hero-title {
  margin-top: 10rpx;
  font-size: 62rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  background: linear-gradient(90deg, #ff4d8d, #a855f7 48%, #2e9be8);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #6b5bb8;
}
.hero-chips {
  margin-top: 26rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
}
.chip {
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 25rpx;
  font-weight: 900;
  border: 4rpx solid #fff;
  box-shadow: 0 6rpx 0 rgba(61, 58, 110, 0.12);
}
.chip.gold {
  background: #ffe066;
  color: #8a5a00;
}
.chip.fire {
  background: #86f0c8;
  color: #0b7a55;
}
.chip.wrong {
  background: #ffb3d1;
  color: #c21e6a;
}

/* ===== 今日 20 分钟 ===== */
.today-card {
  margin-bottom: 20rpx;
}
.today-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.today-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.progress-track {
  height: 22rpx;
  background: #f1ecff;
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow: inset 0 3rpx 6rpx rgba(93, 74, 156, 0.12);
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffd335, #ff9f43 55%, #ff4d8d);
  border-radius: 999rpx;
  box-shadow: inset 0 3rpx 0 rgba(255, 255, 255, 0.4);
  transition: width 0.4s;
}

/* ===== 三维选择器：糖果胶囊 ===== */
.picker-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.picker-btn {
  background: #fff;
  border: 3rpx solid #bde7ff;
  color: #2e9be8;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  font-weight: 900;
  white-space: nowrap;
  box-shadow: 0 6rpx 0 #d8eeff;
}

/* ===== 科目岛卡片 ===== */
.subject-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  transition: transform 0.15s ease;
}
.subject-left {
  flex-shrink: 0;
}
.subject-card:active {
  transform: scale(0.97);
}
.subject-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  font-size: 56rpx;
  background: linear-gradient(135deg, #fff0f8, #f1ecff);
  border: 3rpx solid #fff;
  border-radius: 30rpx;
  box-shadow: 0 6rpx 0 rgba(139, 108, 255, 0.14);
  flex-shrink: 0;
  box-sizing: border-box;
}
.subject-main {
  flex: 1;
  min-width: 0;
}
.subject-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.subject-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.subject-tagline {
  font-size: 24rpx;
  color: #8a87b8;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subject-meta {
  font-size: 20rpx;
  color: #a5a1cc;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subject-go {
  background: #ffe3ee;
  color: #e0407f;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 900;
  font-size: 26rpx;
  box-shadow: 0 6rpx 0 rgba(224, 64, 127, 0.16);
}

/* ===== 错误 / 离线态 ===== */
.error-box {
  text-align: center;
  padding: 60rpx 30rpx;
}
.error-emoji {
  font-size: 70rpx;
}
.error-text {
  color: #e0407f;
  font-weight: 800;
  margin: 20rpx 0;
}
.retry-btn {
  margin: 10rpx 60rpx;
}
.error-hint {
  font-size: 22rpx;
  color: #a5a1cc;
}

.offline-tip {
  background: #fff1bf;
  color: #a16207;
  font-size: 22rpx;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  margin-bottom: 16rpx;
  text-align: center;
}

.back-btn {
  margin: 10rpx 60rpx;
}
.tabbar-space {
  height: 140rpx;
}
