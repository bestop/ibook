.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ===== 首页 Hero：蛋仔天空（云朵星星点缀 + 小岛右上太阳分享钮） ===== */
.hero {
  position: relative;
  text-align: center;
  padding: 28rpx 8rpx 12rpx;
}
.hero-cloud,
.hero-star {
  position: absolute;
}
.hero-cloud {
  left: 16rpx;
  top: 8rpx;
  font-size: 44rpx;
  animation: eggy-float 3.6s ease-in-out infinite;
}
.hero-star {
  right: 24rpx;
  top: 20rpx;
  font-size: 40rpx;
  animation: eggy-float 3.6s ease-in-out infinite;
  animation-delay: 1.2s;
}
@keyframes island-bob {
  0%,
  100% {
    transform: translateY(0) rotate(-3deg);
  }
  50% {
    transform: translateY(-18rpx) rotate(3deg);
  }
}
.hero-bubble {
  position: relative;
  display: inline-block;
  max-width: 100%;
  box-sizing: border-box;
  background: #fff;
  border: 4rpx solid #a9e2ff;
  border-radius: 32rpx;
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #1289c9;
  box-shadow: 0 8rpx 0 rgba(43, 179, 245, 0.18);
  animation: eggy-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.hero-bubble::after {
  content: '';
  position: absolute;
  left: 80rpx;
  bottom: -16rpx;
  width: 26rpx;
  height: 26rpx;
  background: #fff;
  border-right: 4rpx solid #a9e2ff;
  border-bottom: 4rpx solid #a9e2ff;
  transform: rotate(45deg);
}
.hero-island-wrap {
  position: relative; /* 太阳分享钮的定位锚点：跟随小岛 */
  margin-top: 36rpx;
}
.hero-island {
  position: relative;
  display: block;
  font-size: 130rpx;
  line-height: 1.1;
  animation: island-bob 3s ease-in-out infinite;
}
/* 小岛底座：海面椭圆影随小岛一起飘 */
.hero-island::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: -14rpx;
  width: 190rpx;
  height: 30rpx;
  margin-left: -95rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(43, 179, 245, 0.28), rgba(43, 179, 245, 0) 70%);
  z-index: -1;
}
.hero-title {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 62rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-indent: 2rpx; /* 补偿尾字 letter-spacing，渐变文字视觉居中 */
  background: linear-gradient(90deg, #2bb3f5, #8b5cf6 50%, #ff7ba9);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  -webkit-text-fill-color: transparent;
  /* 蛋仔贴纸字：drop-shadow 不破坏渐变字，双层向下叠出白胶厚度 */
  filter: drop-shadow(0 4rpx 0 #ffffff) drop-shadow(0 10rpx 0 rgba(139, 92, 246, 0.16));
  transform: rotate(-1.5deg);
}
.hero-sub {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #6b5bb8;
}
.hero-chips {
  margin-top: 26rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 14rpx;
}
/* 贴纸胶囊：白描边 + 微倾斜 */
.chip {
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 25rpx;
  font-weight: 900;
  border: 4rpx solid #fff;
  box-shadow: 0 6rpx 0 rgba(61, 58, 110, 0.1), 0 10rpx 18rpx rgba(61, 58, 110, 0.08);
}
.hero-chips .chip:nth-child(1) { transform: rotate(-2deg); }
.hero-chips .chip:nth-child(2) { transform: rotate(1.5deg); }
.hero-chips .chip:nth-child(3) { transform: rotate(-1deg); }
.chip.gold {
  background: #ffe066;
  color: #8a5a00;
}
.chip.fire {
  background: #a8f0d4;
  color: #0b7a55;
}
.chip.wrong {
  background: #ffd9e8;
  color: #c21e6a;
}

/* ===== 太阳分享钮：小岛右上方的晴天太阳 =====
   结构解耦：button 仅作透明触发壳（!important 压制微信默认样式），
   视觉全部由内部 .sun-pill 承担，任何基础库下尺寸都稳定 */
.sun-fab {
  position: absolute;
  top: -46rpx;
  right: 182rpx;
  width: 84rpx !important;
  min-width: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  border: none;
  border-radius: 0;
  line-height: 1 !important;
  overflow: visible;
  z-index: 5;
}
.sun-fab::after {
  border: none; /* 重置微信 button 默认描边 */
}
.sun-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 38%, #fff9d9 0%, #ffe066 52%, #ffc93c 100%);
  box-shadow:
    0 0 26rpx 6rpx rgba(255, 214, 64, 0.5),
    inset 0 6rpx 0 rgba(255, 255, 255, 0.65),
    0 6rpx 0 rgba(232, 164, 0, 0.4),
    0 12rpx 18rpx rgba(255, 201, 60, 0.35);
  animation: sun-shine 2.6s ease-in-out infinite;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.sun-icon {
  font-size: 46rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 0 rgba(255, 255, 255, 0.55));
}
/* 晴天呼吸：轻轻鼓起 + 摇摆，像太阳在发光 */
@keyframes sun-shine {
  0%,
  100% {
    transform: scale(1) rotate(-6deg);
  }
  50% {
    transform: scale(1.08) rotate(8deg);
  }
}
.sun-fab:active .sun-pill {
  transform: scale(0.88); /* 按压缩放反馈 */
  animation: none;
}

/* ===== 今日 20 分钟 ===== */
.today-card {
  margin-bottom: 20rpx;
  overflow: hidden; /* 外框硬保证：任何字况下内容不越出卡片边框 */
}
.today-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.today-title {
  font-size: 30rpx;
  font-weight: 900;
  color: #3d3a6e;
  white-space: nowrap; /* 一行排布 */
  flex-shrink: 0; /* 标题完整显示：不缩不省略 */
}
.progress-track {
  position: relative;
  height: 26rpx;
  background: #f1ecff;
  border: 3rpx solid #fff;
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow:
    inset 0 3rpx 6rpx rgba(93, 74, 156, 0.14),
    0 4rpx 0 rgba(148, 180, 255, 0.18);
}
/* 糖果条纹流动进度：活力黄→湖蓝渐变 + 白色斜纹 */
.progress-fill {
  height: 100%;
  background-image:
    repeating-linear-gradient(45deg, rgba(255, 255, 255, 0.4) 0 12rpx, rgba(255, 255, 255, 0) 12rpx 24rpx),
    linear-gradient(90deg, #ffd335, #3ec6ff);
  border-radius: 999rpx;
  box-shadow: inset 0 3rpx 0 rgba(255, 255, 255, 0.45);
  transition: width 0.4s;
  animation: stripe-move 1.2s linear infinite;
}

/* ===== 三维选择器：三等分一行，湖蓝果冻胶囊 ===== */
.picker-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 8rpx;
}
.picker-cell {
  flex: 1;
  min-width: 0;
}
.picker-btn {
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  background: linear-gradient(180deg, #ffffff 0%, #f0faff 100%);
  border: 3rpx solid #bde7ff;
  color: #1b8fd1;
  border-radius: 999rpx;
  padding: 14rpx 8rpx;
  font-size: 25rpx;
  font-weight: 900;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.8),
    0 6rpx 0 #d8eeff;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.15s ease;
}
/* 贴纸微倾斜：三颗胶囊左右交错的贴纸感 */
.picker-row .picker-cell:nth-child(1) .picker-btn { transform: rotate(-1.2deg); }
.picker-row .picker-cell:nth-child(3) .picker-btn { transform: rotate(1.2deg); }
.picker-btn:active {
  transform: translateY(4rpx) scale(0.98);
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.8),
    0 2rpx 0 #d8eeff;
}

/* ===== 科目岛卡片：软塑胶贴纸盒 ===== */
.subject-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.subject-card:active {
  transform: scale(0.96);
}
.subject-left {
  flex-shrink: 0;
}
.subject-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  height: 92rpx;
  font-size: 56rpx;
  background: linear-gradient(135deg, #fff3f9, #eaf8ff);
  border: 3rpx solid #fff;
  border-radius: 30rpx;
  box-shadow:
    inset 0 5rpx 0 rgba(255, 255, 255, 0.85),
    0 6rpx 0 rgba(148, 180, 255, 0.18);
  flex-shrink: 0;
  box-sizing: border-box;
}
.subject-main {
  flex: 1;
  min-width: 0;
}
.subject-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.subject-name {
  font-size: 34rpx;
  font-weight: 900;
  color: #3d3a6e;
}
.subject-tagline {
  font-size: 24rpx;
  color: #8a87b8;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subject-meta {
  font-size: 20rpx;
  color: #a5a1cc;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 出发按钮：活力黄豆荚果冻（与太阳钮同色系） */
.subject-go {
  background: linear-gradient(180deg, #ffe066 0%, #ffc93c 100%);
  color: #8a5a00;
  border: 3rpx solid #fff;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-weight: 900;
  font-size: 26rpx;
  white-space: nowrap;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.5),
    0 5rpx 0 rgba(232, 164, 0, 0.35),
    0 10rpx 16rpx rgba(255, 201, 60, 0.25);
  text-shadow: 0 2rpx 0 rgba(255, 255, 255, 0.4);
}

/* ===== 错误 / 离线态 ===== */
.error-box {
  text-align: center;
  padding: 60rpx 30rpx;
}
.error-emoji {
  font-size: 70rpx;
}
.error-text {
  color: #f03e6b;
  font-weight: 800;
  margin: 20rpx 0;
}
.retry-btn {
  margin: 10rpx 60rpx;
}
.error-hint {
  font-size: 22rpx;
  color: #a5a1cc;
}

.tabbar-space {
  height: 200rpx; /* 悬浮 Dock：胶囊高+bottom 16rpx+safe-area */
}
