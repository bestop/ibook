<view class="page">
  <!-- 首页 Hero：问候气泡 + 海岛 + 标题 + 状态胶囊（与网页版一致） -->
  <view class="hero">
    <text class="hero-cloud">☁️</text>
    <text class="hero-rainbow">🌈</text>
    <text class="hero-star">🌟</text>
    <text class="hero-egg">🥚</text>
    <view class="hero-bubble">嗨，小岛民！今天想去哪个岛冒险呀？</view>
    <text class="hero-island">🏝️</text>
    <view class="hero-title">童学冒险岛</view>
    <view class="hero-sub">一至六年级 · 闯关赢金币 · 越玩越聪明</view>
    <view class="hero-chips">
      <view class="chip gold">🪙 {{coins}}</view>
      <view class="chip fire">🔥 连续 {{streak}} 天</view>
      <view class="chip wrong">📕 错题 {{wrongCount}}</view>
    </view>
  </view>

  <!-- 加载 / 错误态 -->
  <view wx:if="{{loading}}" class="empty-tip">🏝️ 内容准备中…</view>
  <view wx:elif="{{error && subjects.length === 0}}" class="error-box card">
    <view class="error-emoji">😵</view>
    <view class="error-text">内容加载失败：{{error}}</view>
    <button hover-class="none" class="btn-primary retry-btn" bindtap="retry">重新加载</button>
    <view class="error-hint">网络开小差啦，请检查网络后重试</view>
  </view>

  <block wx:else>
    <!-- 今日 20 分钟 -->
    <view class="card today-card">
      <view class="today-head">
        <text class="today-title">⛵ 今日 20 分钟小目标</text>
        <text class="tag">{{todayMinutes || 0}}/20 分钟</text>
      </view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{minutePct}}%"></view>
      </view>
    </view>

    <!-- 三维教材选择器 -->
    <view class="picker-row">
      <picker mode="selector" range="{{gradeLabels}}" value="{{gradeIndex}}" bindchange="onPickGrade">
        <view class="picker-btn">🎓 {{gradeLabels[gradeIndex]}} ▾</view>
      </picker>
      <picker mode="selector" range="{{termLabels}}" value="{{termIndex}}" bindchange="onPickTerm">
        <view class="picker-btn">📖 {{termLabels[termIndex]}} ▾</view>
      </picker>
      <picker mode="selector" range="{{publisherLabels}}" value="{{pubIndex}}" bindchange="onPickPublisher">
        <view class="picker-btn">📚 {{publisherLabels[pubIndex]}} ▾</view>
      </picker>
    </view>

    <!-- 科目岛列表：标题左 + 分享胶囊右 -->
    <view class="section-row">
      <view class="section-title">🗺️ 选一个岛出发</view>
      <button hover-class="none" class="share-fab" open-type="share" aria-label="分享给小伙伴">分享</button>
    </view>

    <view wx:if="{{subjects.length === 0}}" class="card empty-tip">
      <view style="font-size: 60rpx">🗺️</view>
      <view style="margin: 16rpx 0">这个组合下暂无科目岛，换个年级或版本试试～</view>
      <view style="font-size: 22rpx; color: #a5a1cc">语数英一至六年级上下册已全部开放，换个年级或版本试试～</view>
    </view>

    <view
      wx:for="{{subjects}}"
      wx:key="id"
      class="card subject-card"
      data-id="{{item.id}}"
      data-name="{{item.grade}}{{item.name}}"
      bindtap="openSubject"
    >
      <view class="subject-left">
        <text class="subject-emoji">{{item.emoji}}</text>
      </view>
      <view class="subject-main">
        <view class="subject-name-row">
          <text class="subject-name">{{item.name}}岛</text>
          <text wx:if="{{item.badge}}" class="tag">{{item.badge}}</text>
        </view>
        <view class="subject-tagline">{{item.tagline}}</view>
        <view class="subject-meta">📖 {{item.publisher}}</view>
      </view>
      <view class="subject-go">出发 ›</view>
    </view>
  </block>

  <view class="tabbar-space"></view>
  <mp-tabbar active="home" wrong-count="{{wrongCount}}" />
</view>
