.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}
.error-box {
  text-align: center;
  padding: 60rpx 30rpx;
}
.error-emoji {
  font-size: 70rpx;
}
.error-text {
  color: #f03e6b;
  font-weight: 800;
  margin: 20rpx 0 24rpx;
}

/* ===== 顶栏：进度 / 生命 / 金币 ===== */
.quiz-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
/* HUD 贴纸化：半透明白描边 + 柔影（去倾斜与硬底） */
.quiz-progress {
  background: linear-gradient(180deg, #ffffff, #f0faff);
  border: 2rpx solid #cfe9fb;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #1b8fd1;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.85),
    0 8rpx 18rpx rgba(93, 74, 156, 0.1);
}
.quiz-lives {
  display: flex;
  align-items: center;
}
.heart {
  font-size: 30rpx;
  opacity: 0.25;
  margin-right: 4rpx;
}
.heart-on {
  opacity: 1;
  animation: eggy-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.quiz-coins {
  background: linear-gradient(180deg, #fff1bf, #ffe066);
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #a16207;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.6),
    0 8rpx 18rpx rgba(93, 74, 156, 0.1);
}

.quiz-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
/* 长科目标签：超出收缩省略，不挤掉连击徽章 */
.quiz-sub .tag {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 连击徽章：粉底贴纸 + 节奏跳动 */
.combo {
  display: inline-block;
  background: linear-gradient(180deg, #ffd9e8, #ffc2da);
  color: #e0407f;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
  font-weight: 900;
  font-size: 26rpx;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.6),
    0 8rpx 18rpx rgba(224, 64, 127, 0.12);
  animation: combo-pulse 0.8s ease-in-out infinite;
}

/* ===== 倒计时 ===== */
.timer-track {
  height: 18rpx;
  background: #fff;
  border: 3rpx solid #f2edff;
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow: inset 0 3rpx 6rpx rgba(93, 74, 156, 0.1);
}
.timer-fill {
  height: 100%;
  background: linear-gradient(90deg, #3ed598, #b4e33d);
  transition: width 1s linear;
}
.timer-danger {
  background: linear-gradient(90deg, #ff5e7e, #ffc93c);
  animation: pulse-soft 0.6s ease-in-out infinite; /* 告急脉动提醒 */
}
.timer-num {
  text-align: right;
  font-size: 24rpx;
  color: #8a87b8;
  font-weight: 900;
  margin: 8rpx 4rpx 16rpx;
}
.num-danger {
  color: #f03e6b;
}

/* ===== 题目卡：顶部糖果彩带 ===== */
.question-card {
  position: relative;
  margin-bottom: 20rpx;
  animation: eggy-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.question-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 36rpx;
  right: 36rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffd335, #3ec6ff, #ff7ba9);
  opacity: 0.55;
}
.q-tag {
  display: inline-block;
  background: #dff3ff;
  color: #1b8fd1;
  font-size: 20rpx;
  font-weight: 900;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin-bottom: 12rpx;
}
.q-text {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.6;
  color: #3d3a6e;
}

/* ===== 选项：果冻条（交错浮起入场，每题重放） ===== */
/* 列表容器：交错入场的 nth-child 局部计数锚点 */
.option-list {
  min-width: 0;
}
.option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border: 2rpx solid #f2edff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 8rpx 18rpx rgba(93, 74, 156, 0.08);
  transition: all 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: rise-in 0.24s ease-out backwards;
}
/* 交错延迟：选项逐个浮现（延迟极短，不拖慢作答节奏） */
.option:nth-child(1) { animation-delay: 0.03s; }
.option:nth-child(2) { animation-delay: 0.06s; }
.option:nth-child(3) { animation-delay: 0.09s; }
.option:nth-child(4) { animation-delay: 0.12s; }
.option:nth-child(n + 5) { animation-delay: 0.15s; }
.option:active {
  transform: translateY(3rpx) scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(93, 74, 156, 0.08);
}
/* 键位圆点：立体糖果按键 */
.option-key {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #9b6bff, #7c4dff);
  border: 3rpx solid #fff;
  color: #fff;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  text-shadow: 0 2rpx 0 rgba(93, 44, 194, 0.4);
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.35),
    0 4rpx 0 rgba(124, 77, 255, 0.35);
}
.option-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #3d3a6e;
  line-height: 1.5;
  word-break: break-word; /* 长英文单词/拼音也能自适应换行不溢出 */
}
.option-correct {
  background: #dff9ee;
  border-color: #3ed598;
  box-shadow: 0 8rpx 18rpx rgba(14, 159, 110, 0.16);
  animation: eggy-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation-delay: 0s; /* 答题反馈必须即时：归零入场交错延迟 */
}
.option-correct .option-key {
  background: linear-gradient(180deg, #4ee0a8, #3ed598);
  color: #fff;
  text-shadow: 0 2rpx 0 rgba(11, 122, 85, 0.4);
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.35),
    0 4rpx 0 rgba(14, 159, 110, 0.35);
}
.option-wrong {
  background: #ffe9ef;
  border-color: #ff5e7e;
  box-shadow: 0 8rpx 18rpx rgba(240, 62, 107, 0.14);
  animation-delay: 0s; /* 答题反馈必须即时：归零入场交错延迟 */
}
.option-wrong .option-key {
  background: linear-gradient(180deg, #ff7d97, #ff5e7e);
  color: #fff;
  text-shadow: 0 2rpx 0 rgba(194, 30, 106, 0.4);
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.35),
    0 4rpx 0 rgba(240, 62, 107, 0.35);
}
.option-dim {
  opacity: 0.55;
}

/* ===== 解析卡 ===== */
.explain-card {
  border-width: 2rpx;
  animation: rise-in 0.25s ease-out; /* 每次作答后新建节点，入场浮起 */
}
.explain-ok {
  background: #f0fff9;
  border-color: #a9f0d6;
  box-shadow: 0 14rpx 30rpx rgba(14, 159, 110, 0.1);
}
.explain-bad {
  background: #fff0f4;
  border-color: #ffc9da;
  box-shadow: 0 14rpx 30rpx rgba(240, 62, 107, 0.08);
}
.explain-head {
  font-size: 30rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
  color: #3d3a6e;
}
.explain-text {
  font-size: 26rpx;
  color: #5b5486;
  line-height: 1.6;
}
.next-btn {
  margin-top: 20rpx;
}
.tabbar-space {
  height: 60rpx;
}
