.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}
.error-box {
  text-align: center;
  padding: 60rpx 30rpx;
}
.error-emoji {
  font-size: 70rpx;
}
.error-text {
  color: #f03e6b;
  font-weight: 800;
  margin: 20rpx 0 24rpx;
}

/* ===== 顶栏：进度 / 生命 / 金币 ===== */
.quiz-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
/* HUD 贴纸化：半透明白描边 + 柔影（去倾斜与硬底） */
.quiz-progress {
  background: linear-gradient(180deg, #ffffff, #f0faff);
  border: 2rpx solid #cfe9fb;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #1b8fd1;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.85),
    0 8rpx 18rpx rgba(93, 74, 156, 0.1);
}
.quiz-lives {
  display: flex;
  align-items: center;
}
/* 裸 emoji 直出（Task 28 去芯片）：红心尺寸沿用原芯片字形档 */
.heart {
  font-size: 32rpx;
  line-height: 1;
  opacity: 0.22;
  margin-right: 4rpx;
}
.heart-on {
  opacity: 1;
  animation: eggy-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
/* 白底贴纸胶囊 + 裸金币 emoji（与首页状态胶囊同语言，Task 28 去芯片） */
.quiz-coins {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #ffffff;
  border: 2rpx solid #e5e5e5;
  border-radius: 999rpx;
  padding: 8rpx 22rpx 8rpx 16rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #8a5a00;
  box-shadow: 0 4rpx 0 rgba(0, 0, 0, 0.06);
}

.quiz-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
/* 长科目标签：超出收缩省略，不挤掉连击徽章 */
.quiz-sub .tag {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 连击徽章：火焰橙红渐变 + 节奏跳动（与网页端 combo 同色系） */
.combo {
  display: inline-block;
  background: linear-gradient(180deg, #ff9600, #f43f5e);
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
  font-weight: 900;
  font-size: 26rpx;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.45),
    0 8rpx 18rpx rgba(244, 63, 94, 0.16);
  animation: combo-pulse 0.8s ease-in-out infinite;
}

/* ===== 倒计时 ===== */
.timer-track {
  height: 18rpx;
  background: #fff;
  border: 3rpx solid #f2edff;
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow: inset 0 3rpx 6rpx rgba(93, 74, 156, 0.1);
}
.timer-fill {
  height: 100%;
  background: linear-gradient(90deg, #3ed598, #b4e33d);
  transition: width 1s linear;
}
.timer-danger {
  background: linear-gradient(90deg, #ff5e7e, #ffc93c);
  animation: pulse-soft 0.6s ease-in-out infinite; /* 告急脉动提醒 */
}
.timer-num {
  text-align: right;
  font-size: 24rpx;
  color: #8a87b8;
  font-weight: 900;
  margin: 8rpx 4rpx 16rpx;
}
.num-danger {
  color: #f03e6b;
}

/* ===== 题目卡：顶部糖果彩带 ===== */
.question-card {
  position: relative;
  margin-bottom: 20rpx;
  animation: eggy-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.question-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 36rpx;
  right: 36rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ffd335, #3ec6ff, #ff7ba9);
  opacity: 0.55;
}
.q-tag {
  display: inline-block;
  background: #dff3ff;
  color: #1b8fd1;
  font-size: 20rpx;
  font-weight: 900;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin-bottom: 12rpx;
}
.q-text {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.6;
  color: #3d3a6e;
}

/* ===== 选项：果冻条（交错浮起入场，每题重放） ===== */
/* 列表容器：交错入场的 nth-child 局部计数锚点 */
.option-list {
  min-width: 0;
}
.option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border: 4rpx solid var(--dl-swan);
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 4rpx 0 var(--dl-swan);
  transition: all 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation: rise-in 0.24s ease-out backwards;
}
/* 交错延迟：选项逐个浮现（延迟极短，不拖慢作答节奏） */
.option:nth-child(1) { animation-delay: 0.03s; }
.option:nth-child(2) { animation-delay: 0.06s; }
.option:nth-child(3) { animation-delay: 0.09s; }
.option:nth-child(4) { animation-delay: 0.12s; }
.option:nth-child(n + 5) { animation-delay: 0.15s; }
.option:active {
  transform: translateY(3rpx) scale(0.98);
  box-shadow: 0 2rpx 0 var(--dl-swan);
}
/* 键位圆点：多邻国鳍鱼蓝立体按键 */
.option-key {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #4fc3f7, var(--dl-eel-blue));
  border: 3rpx solid #fff;
  color: #fff;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  box-sizing: border-box;
  text-shadow: 0 2rpx 0 rgba(16, 110, 160, 0.4);
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.35),
    0 4rpx 0 rgba(24, 153, 214, 0.35);
}
.option-text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #3d3a6e;
  line-height: 1.5;
  word-break: break-word; /* 长英文单词/拼音也能自适应换行不溢出 */
}
.option-correct {
  background: var(--dl-owl-green-pale);
  border-color: var(--dl-owl-green);
  box-shadow: 0 4rpx 0 rgba(88, 167, 0, 0.35);
  animation: eggy-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  animation-delay: 0s; /* 答题反馈必须即时：归零入场交错延迟 */
}
.option-correct .option-key {
  background: linear-gradient(180deg, #7be12d, var(--dl-owl-green));
  color: #fff;
  text-shadow: 0 2rpx 0 rgba(63, 143, 0, 0.4);
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.35),
    0 4rpx 0 rgba(88, 167, 0, 0.35);
}
.option-wrong {
  background: #ffdfe0;
  border-color: var(--dl-cardinal-red);
  box-shadow: 0 4rpx 0 rgba(214, 49, 49, 0.3);
  animation-delay: 0s; /* 答题反馈必须即时：归零入场交错延迟 */
}
.option-wrong .option-key {
  background: linear-gradient(180deg, #ff6060, var(--dl-cardinal-red));
  color: #fff;
  text-shadow: 0 2rpx 0 rgba(194, 30, 30, 0.4);
  box-shadow:
    inset 0 4rpx 0 rgba(255, 255, 255, 0.35),
    0 4rpx 0 rgba(214, 49, 49, 0.3);
}
.option-dim {
  opacity: 0.55;
}

/* ===== 解析卡 ===== */
.explain-card {
  border-width: 2rpx;
  animation: rise-in 0.25s ease-out; /* 每次作答后新建节点，入场浮起 */
}
.explain-ok {
  background: #f0fff9;
  border-color: #a9f0d6;
  box-shadow: 0 14rpx 30rpx rgba(14, 159, 110, 0.1);
}
.explain-bad {
  background: #fff0f4;
  border-color: #ffc9da;
  box-shadow: 0 14rpx 30rpx rgba(240, 62, 107, 0.08);
}
.explain-head {
  font-size: 30rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
  color: #3d3a6e;
}
.explain-text {
  font-size: 26rpx;
  color: #5b5486;
  line-height: 1.6;
}
/* 宠物应援条：解析卡内轻量气泡（借鉴聪聪学堂 Mascot reaction，与网页版同构） */
.pet-cheer {
  margin-top: 14rpx;
  padding: 12rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  font-weight: 800;
  color: #7a5cc4;
}
.next-btn {
  margin-top: 20rpx;
}
.tabbar-space {
  height: 60rpx;
}

/* ===== 考点锦囊（借鉴聪聪学堂知识讲解卡，与网页版考点锦囊同构） ===== */
.level-tips {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 16rpx 0 4rpx;
  padding: 16rpx 22rpx;
  background: linear-gradient(180deg, #e3f6ff 0%, #d5f1ff 100%);
  border: 2rpx solid rgba(62, 198, 255, 0.45);
  border-radius: 24rpx;
  animation: rise-in 0.25s ease-out;
}
.level-tips-collapsed {
  background: rgba(255, 255, 255, 0.65);
  border-color: rgba(62, 198, 255, 0.25);
}
.level-tips-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.level-tips-text {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #1f7fb8;
  line-height: 1.5;
}
.level-tips-close {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: #1f7fb8;
  opacity: 0.65;
}

/* ===== 连击里程碑（借鉴聪聪学堂 ComboOverlay：3/5/10 连击居中大徽章） ===== */
.combo-milestone-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}
.combo-milestone {
  display: flex;
  align-items: center;
  padding: 26rpx 54rpx;
  border-radius: 48rpx;
  font-size: 56rpx;
  font-weight: 900;
  color: #ffffff;
  text-shadow: 0 3rpx 0 rgba(0, 0, 0, 0.18);
  background: linear-gradient(135deg, #ffc800 0%, #ff9600 50%, #ff4b4b 100%);
  box-shadow:
    0 10rpx 0 rgba(180, 90, 0, 0.35),
    0 26rpx 56rpx rgba(255, 150, 0, 0.45);
  animation: combo-pop 1.4s ease-out forwards;
}
@keyframes combo-pop {
  0% {
    transform: scale(0.2) rotate(-15deg);
    opacity: 0;
  }
  25% {
    transform: scale(1.25) rotate(5deg);
    opacity: 1;
  }
  45% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
  80% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  100% {
    transform: translateY(-90rpx) scale(1);
    opacity: 0;
  }
}

/* ===== 答错抖动（借鉴聪聪学堂答题反馈，与网页版 quiz-view shake 同构） ===== */
.question-shake {
  animation: question-shake 0.5s ease-out;
}
@keyframes question-shake {
  0% { transform: translateX(0); }
  20% { transform: translateX(-20rpx); }
  40% { transform: translateX(20rpx); }
  60% { transform: translateX(-12rpx); }
  80% { transform: translateX(12rpx); }
  100% { transform: translateX(0); }
}

/* ===== 复习模式徽标（借鉴聪聪学堂「错题复习不扣爱心」：红心位改展示巩固语义） ===== */
.quiz-review-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #d1fae5;
  color: #047857;
  font-size: 22rpx;
  font-weight: bold;
  white-space: nowrap;
}
