.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}
.error-box {
  text-align: center;
  padding: 60rpx 30rpx;
}
.error-emoji {
  font-size: 70rpx;
}
.error-text {
  color: #b45309;
  font-weight: 700;
  margin: 20rpx 0 24rpx;
}

.quiz-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.quiz-progress {
  font-size: 30rpx;
  font-weight: 900;
  color: #9a3412;
}
.heart {
  font-size: 30rpx;
  opacity: 0.25;
  margin-right: 4rpx;
}
.heart-on {
  opacity: 1;
}
.quiz-coins {
  font-size: 28rpx;
  font-weight: 900;
  color: #b45309;
}

.quiz-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.combo {
  color: #ea580c;
  font-weight: 900;
  font-size: 26rpx;
}

.timer-track {
  height: 16rpx;
  background: #ffffff;
  border: 2rpx solid #fde68a;
  border-radius: 999rpx;
  overflow: hidden;
}
.timer-fill {
  height: 100%;
  background: linear-gradient(90deg, #22c55e, #84cc16);
  transition: width 1s linear;
}
.timer-danger {
  background: linear-gradient(90deg, #ef4444, #f97316);
}
.timer-num {
  text-align: right;
  font-size: 24rpx;
  color: #b45309;
  font-weight: 800;
  margin: 8rpx 4rpx 16rpx;
}
.num-danger {
  color: #dc2626;
}

.question-card {
  margin-bottom: 20rpx;
}
.q-tag {
  display: inline-block;
  background: #fef3c7;
  color: #b45309;
  font-size: 20rpx;
  font-weight: 800;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin-bottom: 12rpx;
}
.q-text {
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.6;
  color: #431407;
}

.option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 3rpx solid #fde68a;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  transition: all 0.15s;
}
.option-key {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #fef3c7;
  color: #b45309;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}
.option-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #431407;
  line-height: 1.5;
}
.option-correct {
  background: #dcfce7;
  border-color: #22c55e;
}
.option-correct .option-key {
  background: #22c55e;
  color: #fff;
}
.option-wrong {
  background: #fee2e2;
  border-color: #ef4444;
}
.option-wrong .option-key {
  background: #ef4444;
  color: #fff;
}
.option-dim {
  opacity: 0.55;
}

.explain-card {
  border-width: 3rpx;
}
.explain-ok {
  background: #f0fdf4;
  border-color: #86efac;
}
.explain-bad {
  background: #fef2f2;
  border-color: #fca5a5;
}
.explain-head {
  font-size: 30rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
  color: #431407;
}
.explain-text {
  font-size: 26rpx;
  color: #57534e;
  line-height: 1.6;
}
.next-btn {
  margin-top: 20rpx;
}
.tabbar-space {
  height: 60rpx;
}
