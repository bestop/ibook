.page {
  padding: 24rpx 24rpx 0;
  min-height: 100vh;
  box-sizing: border-box;
}
.error-box {
  text-align: center;
  padding: 60rpx 30rpx;
}
.error-emoji {
  font-size: 70rpx;
}
.error-text {
  color: #f03e6b;
  font-weight: 800;
  margin: 20rpx 0 24rpx;
}

/* ===== 顶栏：进度 / 生命 / 金币 ===== */
.quiz-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.quiz-progress {
  background: #fff;
  border: 3rpx solid #bde7ff;
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: #1b8fd1;
  box-shadow: 0 5rpx 0 rgba(27, 143, 209, 0.14);
}
.quiz-lives {
  display: flex;
  align-items: center;
}
.heart {
  font-size: 30rpx;
  opacity: 0.25;
  margin-right: 4rpx;
}
.heart-on {
  opacity: 1;
  animation: eggy-pop 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.quiz-coins {
  background: #fff1bf;
  border: 3rpx solid #fff;
  border-radius: 999rpx;
  padding: 6rpx 22rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #a16207;
  box-shadow: 0 5rpx 0 rgba(240, 164, 0, 0.18);
}

.quiz-sub {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.combo {
  background: #ffd9e8;
  color: #e0407f;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
  font-weight: 900;
  font-size: 26rpx;
  box-shadow: 0 5rpx 0 rgba(224, 64, 127, 0.15);
}

/* ===== 倒计时 ===== */
.timer-track {
  height: 18rpx;
  background: #fff;
  border: 3rpx solid #f2edff;
  border-radius: 999rpx;
  overflow: hidden;
  box-shadow: inset 0 3rpx 6rpx rgba(93, 74, 156, 0.1);
}
.timer-fill {
  height: 100%;
  background: linear-gradient(90deg, #3ed598, #b4e33d);
  transition: width 1s linear;
}
.timer-danger {
  background: linear-gradient(90deg, #ff5e7e, #ffc93c);
}
.timer-num {
  text-align: right;
  font-size: 24rpx;
  color: #8a87b8;
  font-weight: 900;
  margin: 8rpx 4rpx 16rpx;
}
.num-danger {
  color: #f03e6b;
}

/* ===== 题目卡 ===== */
.question-card {
  margin-bottom: 20rpx;
  animation: eggy-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.q-tag {
  display: inline-block;
  background: #dff3ff;
  color: #1b8fd1;
  font-size: 20rpx;
  font-weight: 900;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  margin-bottom: 12rpx;
}
.q-text {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.6;
  color: #3d3a6e;
}

/* ===== 选项：果冻条 ===== */
.option {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border: 3rpx solid #f2edff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 0 rgba(148, 180, 255, 0.12);
  transition: all 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.option:active {
  transform: translateY(4rpx) scale(0.98);
  box-shadow: 0 2rpx 0 rgba(148, 180, 255, 0.12);
}
.option-key {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #e6dcff;
  color: #7c4dff;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
}
.option-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #3d3a6e;
  line-height: 1.5;
}
.option-correct {
  background: #dff9ee;
  border-color: #3ed598;
  box-shadow: 0 6rpx 0 rgba(14, 159, 110, 0.22);
  animation: eggy-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.option-correct .option-key {
  background: #3ed598;
  color: #fff;
}
.option-wrong {
  background: #ffe9ef;
  border-color: #ff5e7e;
  box-shadow: 0 6rpx 0 rgba(240, 62, 107, 0.2);
}
.option-wrong .option-key {
  background: #ff5e7e;
  color: #fff;
}
.option-dim {
  opacity: 0.55;
}

/* ===== 解析卡 ===== */
.explain-card {
  border-width: 3rpx;
}
.explain-ok {
  background: #f0fff9;
  border-color: #a9f0d6;
  box-shadow: 0 8rpx 0 rgba(14, 159, 110, 0.1), 0 20rpx 36rpx rgba(14, 159, 110, 0.08);
}
.explain-bad {
  background: #fff0f4;
  border-color: #ffc9da;
  box-shadow: 0 8rpx 0 rgba(240, 62, 107, 0.08), 0 20rpx 36rpx rgba(240, 62, 107, 0.07);
}
.explain-head {
  font-size: 30rpx;
  font-weight: 900;
  margin-bottom: 10rpx;
  color: #3d3a6e;
}
.explain-text {
  font-size: 26rpx;
  color: #5b5486;
  line-height: 1.6;
}
.next-btn {
  margin-top: 20rpx;
}
.tabbar-space {
  height: 60rpx;
}
